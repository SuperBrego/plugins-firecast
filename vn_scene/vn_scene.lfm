<?xml version="1.0" encoding="UTF-8"?>
<form name="frmVNScene"
      formType="sheetTemplate"
      dataType="br.GodsCorpse.VNScene"
      title="Visual Novel Scene">

    <script>
    <![CDATA[
        require("firecast.lua");
        require("dialogs.lua");
        require("system.lua");
        require("ndb.lua");
        local Utils = require("utils.lua")
        local GUI = require("gui.lua")

        local MAX_EXTRAS   = 6
        local SCENE_FORMAT = "VNSCENE1"
        local SLOT_IDS     = { "left", "center", "right" }
        local SLOT_CONFIG_HEIGHT = 152   -- cabeçalho + 3 camadas
        local CONFIG_BASE_HEIGHT = 1000  -- resto da aba de configuração
        local DEFAULT_NPC_COLOR = "#a89fd8"
        local FOCUS_OPACITY = { 1.0, 0.65, 0.45 }
        -- Slots sem foco perdem 25% da opacidade normal de cada camada.
        local DIM_OPACITY   = { 0.75, 0.4875, 0.3375 }
        local MARKUP_TAGS   = { "b", "i", "u", "s", "color", "size", "font", "url", "img",
                                "center", "quote", "code", "spoiler" }

        local chatReceiver = nil
        local npcCommandListener = nil
        local npcHelpListener = nil
        local npcMap       = {}  -- nome(lower) -> {slot, layer} ou {extra=i}
        local npcDisplayNames = {}  -- nome(lower) -> nome cadastrado
        local extraUrls    = {}  -- URL de cada extra
        local slotUrls     = {
            left   = { "", "", "" },
            center = { "", "", "" },
            right  = { "", "", "" },
        }
        -- Cor do diálogo por NPC (nome em minúsculas -> cor)
        local npcColors = {}
        local dialogExpanded = false
        local layoutDialog
        local fadeTargets = {}       -- nome do controle -> opacidade alvo
        local previewCheckRuns = 0
        local bulkUpdating = false   -- true enquanto vários campos são gravados de uma vez
        local keysCache = nil
        local configDocked = false   -- true: painel de configuração está dentro da aba Cena (modo debug)

        -- ── Utilitários ──────────────────────────────────────────────

        local function slotControls(slotId)
            return {
                self["imgSprite_" .. slotId .. "_1"],
                self["imgSprite_" .. slotId .. "_2"],
                self["imgSprite_" .. slotId .. "_3"],
            }
        end

        local function extraControls(idx)
            return {
                img  = self["imgExtra_" .. idx],
                rect = self["rectExtra_" .. idx],
            }
        end

        local function normalizeNpcName(name)
            return ((name or ""):gsub("^%s*(.-)%s*$", "%1")):lower()
        end

        -- O usuário atual tem permissão de escrita nesta ficha?
        local function canEditSheet()
            if not sheet then return false end
            local ok, allowed = pcall(ndb.testPermission, sheet, "write")
            return ok and allowed == true
        end

        local function setSrc(img, url)
            if img and img.src ~= url then img.src = url end
        end

        local function configuredColor(value)
            return value ~= "" and value or DEFAULT_NPC_COLOR
        end

        -- Torna um nome de tag insensível a maiúsculas: "b" -> "[bB]"
        local function caseInsensitive(word)
            return (word:gsub("%a", function(c) return "[" .. c:lower() .. c:upper() .. "]" end))
        end

        -- Remove BBCode e tags HTML simples das mensagens do chat
        local function cleanMessage(text)
            text = text or ""
            text = text:gsub("</?%a[^>]*>", "")
            for _, tag in ipairs(MARKUP_TAGS) do
                local t = caseInsensitive(tag)
                text = text:gsub("%[/" .. t .. "%]", "")
                text = text:gsub("%[" .. t .. "%]", "")
                text = text:gsub("%[" .. t .. "[=%s][^%]]*%]", "")
            end
            return text
        end

        -- ── Rotação de camadas ───────────────────────────────────────

        local function applySlotOrder(slotId, frontLayer)
            local imgs = slotControls(slotId)
            local urls = slotUrls[slotId]
            local o = {
                frontLayer,
                (frontLayer % 3) + 1,
                ((frontLayer + 1) % 3) + 1
            }
            setSrc(imgs[1], urls[o[1]])
            setSrc(imgs[2], urls[o[2]])
            setSrc(imgs[3], urls[o[3]])
        end

        -- ── Transição suave de opacidade ─────────────────────────────

        local function fadeTo(controlName, value)
            fadeTargets[controlName] = value
            self.tmrFade.enabled = true
        end

        local function onFadeTimer()
            local active = false
            for name, target in pairs(fadeTargets) do
                local img = self[name]
                if img then
                    local current = img.opacity or target
                    local diff = target - current
                    if math.abs(diff) < 0.02 then
                        img.opacity = target
                        fadeTargets[name] = nil
                    else
                        img.opacity = current + diff * 0.35
                        active = true
                    end
                else
                    fadeTargets[name] = nil
                end
            end
            if not active then self.tmrFade.enabled = false end
        end

        -- ── Foco global entre slots ───────────────────────────────────

        local function getFront(slotId)
            local value = sheet and sheet["slot_" .. slotId .. "_front"]
            return tonumber(value) or 1
        end

        -- activeSlotId = nil escurece todos os slots.
        -- activeLayer (opcional) destaca essa camada sem reordenar o slot.
        local function applySlotFocus(activeSlotId, activeLayer)
            for _, sid in ipairs(SLOT_IDS) do
                local active = (sid == activeSlotId)
                local levels = active and FOCUS_OPACITY or DIM_OPACITY

                -- posição atual (1 = frente) da camada que está falando
                local speakingPos = nil
                if active and activeLayer then
                    speakingPos = ((activeLayer - getFront(sid)) % 3) + 1
                end

                for pos = 1, 3 do
                    local level = levels[pos]
                    if speakingPos then
                        level = (pos == speakingPos) and 1.0 or math.min(level, 0.45)
                    end
                    fadeTo("imgSprite_" .. sid .. "_" .. pos, level)
                end
            end
        end

        -- ── Botão de foco manual ─────────────────────────────────────

        local function setFront(slotId, layer)
            if not canEditSheet() then return end
            local value = tostring(layer)
            local field = "slot_" .. slotId .. "_front"
            if sheet[field] ~= value then sheet[field] = value end
        end

        local function setFocus(slotId, layer)
            setFront(slotId, layer)
            applySlotOrder(slotId, layer)
            applySlotFocus(slotId)
            -- Esconde sprite de extra temporário
            self.imgExtraSprite.visible = false
        end

        -- ── Aviso de imagem que não carregou ─────────────────────────

        local function updatePreviewState(img, errLabel, url)
            if not img or not errLabel then return false end
            if url == "" then
                errLabel.visible = false
                return false
            end
            local loaded = (img.naturalWidth or 0) > 0
            errLabel.visible = not loaded
            return not loaded
        end

        local function checkPreviews()
            local pending = false
            for _, slotId in ipairs(SLOT_IDS) do
                for layer = 1, 3 do
                    local suffix = slotId .. "_" .. layer
                    if updatePreviewState(self["imgPreview_" .. suffix],
                                          self["labPreviewErr_" .. suffix],
                                          slotUrls[slotId][layer]) then
                        pending = true
                    end
                end
            end
            for i = 1, MAX_EXTRAS do
                if updatePreviewState(self["imgPreviewExtra_" .. i],
                                      self["labPreviewErrExtra_" .. i],
                                      extraUrls[i] or "") then
                    pending = true
                end
            end
            previewCheckRuns = previewCheckRuns + 1
            if not pending or previewCheckRuns >= 6 then
                self.tmrPreview.enabled = false
            end
        end

        local function schedulePreviewCheck()
            previewCheckRuns = 0
            self.tmrPreview.enabled = false
            self.tmrPreview.enabled = true
        end

        -- ── Carrega configurações ────────────────────────────────────

        local function loadConfig()
            if bulkUpdating then return end
            local node = sheet
            setSrc(self.imgBackground, (node and node.bgUrl) or "")

            npcMap    = {}
            npcDisplayNames = {}
            npcColors = {}
            extraUrls = {}
            local duplicateNames = {}
            local hasExtras = false

            local function registerNpc(name, entry, color)
                local key = normalizeNpcName(name)
                if key == "" then return end
                if npcMap[key] then
                    duplicateNames[key] = true
                    return
                end
                npcMap[key] = entry
                npcDisplayNames[key] = ((name or ""):gsub("^%s*(.-)%s*$", "%1"))
                npcColors[key] = color
            end

            for _, slotId in ipairs(SLOT_IDS) do
                local visible = (node and node["slot_" .. slotId .. "_visible"]) == true

                for layer = 1, 3 do
                    local url   = (node and node["slot_" .. slotId .. "_url"   .. layer]) or ""
                    local name  = (node and node["slot_" .. slotId .. "_npc"   .. layer]) or ""
                    local color = configuredColor((node and node["slot_" .. slotId .. "_color" .. layer]) or "")
                    slotUrls[slotId][layer] = url
                    registerNpc(name, { slot = slotId, layer = layer }, color)
                end

                local frontStr = (node and node["slot_" .. slotId .. "_front"]) or "1"
                local front    = tonumber(frontStr) or 1
                applySlotOrder(slotId, front)

                local imgs = slotControls(slotId)
                imgs[1].visible = visible
                imgs[2].visible = visible
                imgs[3].visible = visible

                -- Preview por linha
                for layer = 1, 3 do
                    local prevImg = self["imgPreview_" .. slotId .. "_" .. layer]
                    setSrc(prevImg, slotUrls[slotId][layer])
                end
            end

            for i = 1, MAX_EXTRAS do
                local npcName = (node and node["extra_" .. i .. "_npc"])   or ""
                local url     = (node and node["extra_" .. i .. "_url"])   or ""
                local color   = configuredColor((node and node["extra_" .. i .. "_color"]) or "")
                extraUrls[i]  = url
                if url ~= "" or npcName ~= "" then hasExtras = true end
                local ctrls   = extraControls(i)
                setSrc(ctrls.img, url)
                ctrls.rect.visible = (url ~= "" or npcName ~= "")
                ctrls.img.visible  = (url ~= "")

                registerNpc(npcName, { extra = i }, color)

                -- Preview na config
                local prevImg = self["imgPreviewExtra_" .. i]
                setSrc(prevImg, url)
            end

            local duplicates = {}
            for name in pairs(duplicateNames) do table.insert(duplicates, name) end
            table.sort(duplicates)
            if self.labConfigWarning then
                self.labConfigWarning.visible = #duplicates > 0
                self.labConfigWarning.text = #duplicates > 0
                    and "Nomes de NPC duplicados: " .. table.concat(duplicates, ", ") .. ". O primeiro cadastro será usado."
                    or ""
            end
            self.layExtras.visible = hasExtras
            self.rectExtrasBar.visible = hasExtras and not self.rectDialog.visible
            if self.rectDialog.visible then layoutDialog(self.imgDialogAvatar.visible) end
            schedulePreviewCheck()
        end

        -- Campos de texto: espera o usuário parar de digitar antes de recarregar
        local function scheduleLoadConfig()
            self.tmrConfig.enabled = false
            self.tmrConfig.enabled = true
        end

        -- Abre o seletor nativo de imagens do Firecast. A URL devolvida pode
        -- vir de uma URL comum ou do FireDrive, conforme a origem escolhida.
        local function selecionarImagem(fieldName)
            if not sheet then return end
            dialogs.selectImageURL(sheet[fieldName] or "", function(url)
                if sheet and url ~= nil and url ~= "" then
                    sheet[fieldName] = url
                    loadConfig()
                end
            end)
        end

        local function onConfigTimer()
            self.tmrConfig.enabled = false
            loadConfig()
        end

        local visualNpcColorForm

        local function showVisualNpcColor(current, saveColor)
            if visualNpcColorForm then return end
            local picker = GUI.newPopupForm("frmVnNpcVisualColor")
            if not picker then
                showMessage("O seletor visual do Firecast não pôde ser aberto.")
                return
            end

            local appliedColor
            picker.cboNpcVisualColor.color = current
            picker.btnApplyColor.onClick = function()
                local color = picker.cboNpcVisualColor.color
                if type(color) ~= "string" or color == "" or color:lower() == "null" then return end
                appliedColor = color
                if not picker:close() then appliedColor = nil end
            end

            visualNpcColorForm = picker
            if not GUI.showPopup(picker, { onClose = function()
                if visualNpcColorForm ~= picker then return end
                visualNpcColorForm = nil
                if appliedColor then saveColor(appliedColor) end
            end }) then
                visualNpcColorForm = nil
                showMessage("O seletor visual do Firecast não pôde ser aberto.")
            end
        end

        local function escolherCorNpc(fieldName)
            if not canEditSheet() then return end
            local node = sheet
            local current = configuredColor(node[fieldName] or "")
            showVisualNpcColor(current, function(color)
                if sheet ~= node or not canEditSheet() then return end
                node[fieldName] = color
                loadConfig()
            end)
        end

        -- ── Limpar e girar configuração ──────────────────────────────

        local function resetSlotLayer(node, slotId, layer)
            local prefix = "slot_" .. slotId .. "_"
            node[prefix .. "npc" .. layer] = ""
            node[prefix .. "url" .. layer] = ""
            node[prefix .. "color" .. layer] = DEFAULT_NPC_COLOR
        end

        local function clearSlotNpc(slotId, layer)
            if not canEditSheet() then return end
            resetSlotLayer(sheet, slotId, layer)
            loadConfig()
        end

        local function resetSlotFields(node, slotId)
            node["slot_" .. slotId .. "_front"] = "1"
            for layer = 1, 3 do
                resetSlotLayer(node, slotId, layer)
            end
        end

        local function resetAllFields(node)
            node.bgUrl = ""

            for _, slotId in ipairs(SLOT_IDS) do
                node["slot_" .. slotId .. "_visible"] = false
                resetSlotFields(node, slotId)
            end

            for i = 1, MAX_EXTRAS do
                node["extra_" .. i .. "_npc"]   = ""
                node["extra_" .. i .. "_url"]   = ""
                node["extra_" .. i .. "_color"] = DEFAULT_NPC_COLOR
            end
        end

        local function clearConfig()
            if not sheet then return end
            bulkUpdating = true
            resetAllFields(sheet)
            bulkUpdating = false
            loadConfig()
        end

        local function confirmClearConfig()
            Dialogs.confirmYesNo("Apagar todos os nomes, cores e imagens da cena?", function(confirmed)
                if confirmed then clearConfig() end
            end)
        end

        local function confirmClearSlot(slotId)
            Dialogs.confirmYesNo("Apagar nomes, cores e imagens deste slot?", function(confirmed)
                if not confirmed or not sheet then return end
                resetSlotFields(sheet, slotId)
                loadConfig()
            end)
        end

        -- O que estava na frente vai para trás; Meio sobe para Frente e Atrás para Meio
        local function rotateSlot(slotId)
            local node = sheet
            if not node then return end

            for _, field in ipairs({ "npc", "url", "color" }) do
                local default = (field == "color") and DEFAULT_NPC_COLOR or ""
                local key = "slot_" .. slotId .. "_" .. field
                local front, middle, back = node[key .. "1"], node[key .. "2"], node[key .. "3"]
                node[key .. "1"] = middle or default
                node[key .. "2"] = back   or default
                node[key .. "3"] = front  or default
            end

            loadConfig()
        end

        -- ── Exportar, importar e cenas salvas ────────────────────────

        -- Campos que compõem uma cena (as cenas salvas ficam fora, em scene_N_*)
        local function configKeys()
            if keysCache then return keysCache end
            local keys = { "bgUrl" }
            for _, slotId in ipairs(SLOT_IDS) do
                keys[#keys + 1] = "slot_" .. slotId .. "_visible"
                keys[#keys + 1] = "slot_" .. slotId .. "_front"
                for layer = 1, 3 do
                    keys[#keys + 1] = "slot_" .. slotId .. "_npc"   .. layer
                    keys[#keys + 1] = "slot_" .. slotId .. "_url"   .. layer
                    keys[#keys + 1] = "slot_" .. slotId .. "_color" .. layer
                end
            end
            for i = 1, MAX_EXTRAS do
                keys[#keys + 1] = "extra_" .. i .. "_npc"
                keys[#keys + 1] = "extra_" .. i .. "_url"
                keys[#keys + 1] = "extra_" .. i .. "_color"
            end
            keysCache = keys
            return keys
        end

        local function isBooleanKey(key)
            return key:sub(-8) == "_visible"
        end

        -- Texto no formato: primeira linha VNSCENE1, depois uma linha chave=valor por campo
        local function encodeConfig(node)
            local lines = { SCENE_FORMAT }
            for _, key in ipairs(configKeys()) do
                local value = node[key]
                if value == nil then value = isBooleanKey(key) and false or "" end
                value = tostring(value):gsub("[\r\n]+", " ")
                lines[#lines + 1] = key .. "=" .. value
            end
            return table.concat(lines, "\n")
        end

        local function trim(text)
            return (text:gsub("^%s*(.-)%s*$", "%1"))
        end

        -- Devolve tabela chave -> valor, ou nil se o texto não for uma configuração válida
        local function decodeConfig(text)
            if type(text) ~= "string" then return nil end
            text = text:gsub("^\239\187\191", "")   -- remove BOM UTF-8

            local allowed = {}
            for _, key in ipairs(configKeys()) do allowed[key] = true end

            local values = {}
            local found = 0
            local sawHeader = false
            for rawLine in (text .. "\n"):gmatch("([^\n]*)\n") do
                local line = trim(rawLine)
                if line ~= "" then
                    if not sawHeader then
                        if line ~= SCENE_FORMAT then return nil end
                        sawHeader = true
                    else
                        local key, value = line:match("^([^=]+)=(.*)$")
                        key = key and trim(key)
                        if key and allowed[key] then
                            values[key] = trim(value)
                            found = found + 1
                        end
                    end
                end
            end

            if not sawHeader or found == 0 then return nil end
            return values
        end

        local function defaultFor(key)
            if isBooleanKey(key) then return false end
            if key:find("_color", 1, true) then return DEFAULT_NPC_COLOR end
            if key:sub(-6) == "_front" then return "1" end
            return ""
        end

        -- Tira o estado temporário (extra em cena, foco dimmerizado) ao trocar de cena
        local function resetTransientScene()
            self.imgExtraSprite.visible = false
            for _, sid in ipairs(SLOT_IDS) do
                for pos = 1, 3 do
                    fadeTo("imgSprite_" .. sid .. "_" .. pos, FOCUS_OPACITY[pos])
                end
            end
        end

        -- Grava só o que mudou, sem recarregar a cena a cada campo, e recarrega uma vez no fim
        local function applyValues(node, values)
            bulkUpdating = true
            for _, key in ipairs(configKeys()) do
                local target = values[key]
                if target == nil then
                    target = defaultFor(key)
                elseif isBooleanKey(key) then
                    target = (target == "true")
                end
                if node[key] ~= target then node[key] = target end
            end
            bulkUpdating = false
            resetTransientScene()
            loadConfig()
        end

        local function exportConfig()
            if not sheet then return end
            if System.setClipboardText(encodeConfig(sheet)) then
                showMessage("Configuração copiada. Cole em um arquivo ou mensagem para guardar ou compartilhar.")
            else
                showMessage("Não foi possível copiar para a área de transferência.")
            end
        end

        local function importConfig()
            local values = decodeConfig(System.getClipboardText())
            if not values then
                showMessage("A área de transferência não tem uma configuração válida. Copie o texto inteiro gerado por 'Exportar'.")
                return
            end
            Dialogs.confirmYesNo("Substituir a configuração atual pela que está na área de transferência?", function(confirmed)
                if confirmed and sheet then applyValues(sheet, values) end
            end)
        end

        local function saveScene(n)
            local node = sheet
            if not node then return end
            local nameKey = "scene_" .. n .. "_name"
            if normalizeNpcName(node[nameKey] or "") == "" then node[nameKey] = "Cena " .. n end
            node["scene_" .. n .. "_data"] = encodeConfig(node)
        end

        local function confirmSaveScene(n)
            local node = sheet
            if not node then return end
            if (node["scene_" .. n .. "_data"] or "") == "" then
                saveScene(n)
                return
            end
            Dialogs.confirmYesNo("Já existe uma cena neste espaço. Sobrescrever com a configuração atual?", function(confirmed)
                if confirmed then saveScene(n) end
            end)
        end

        local function confirmLoadScene(n)
            local node = sheet
            if not node then return end
            local values = decodeConfig(node["scene_" .. n .. "_data"])
            if not values then
                showMessage("Este espaço está vazio. Use 'Salvar' para guardar a cena atual aqui.")
                return
            end
            local name = node["scene_" .. n .. "_name"] or ""
            if name == "" then name = "Cena " .. n end
            Dialogs.confirmYesNo("Substituir a configuração atual pela cena \"" .. name .. "\"?", function(confirmed)
                if confirmed and sheet then applyValues(sheet, values) end
            end)
        end

        local function confirmDeleteScene(n)
            local node = sheet
            if node and (node["scene_" .. n .. "_data"] or "") == "" and (node["scene_" .. n .. "_name"] or "") == "" then
                showMessage("Este espaço já está vazio.")
                return
            end
            Dialogs.confirmYesNo("Apagar esta cena salva?", function(confirmed)
                if not confirmed or not sheet then return end
                sheet["scene_" .. n .. "_name"] = ""
                sheet["scene_" .. n .. "_data"] = ""
            end)
        end

        -- ── Diálogo ──────────────────────────────────────────────────

        layoutDialog = function(hasAvatar)
            local spritesBottom = self.imgExtraSprite.top + self.imgExtraSprite.height
            local top = dialogExpanded and math.min(350, spritesBottom) or spritesBottom
            local height = self.frmStage.height - top
            local avatar = self.imgDialogAvatar
            local left = hasAvatar and (avatar.left + avatar.width + 12) or 35
            local right = self.btnDialogExpand.left - 10
            local textOffset, nameRight = 29, right

            self.rectExtrasBar.visible = false
            if self.layExtras.visible then
                self.layExtras.left = right - self.layExtras.width
                self.layExtras.top = top
                textOffset = self.layExtras.height
                nameRight = self.layExtras.left - 8
            end

            self.rectDialog.top = top
            self.rectDialog.height = height
            avatar.top = top + 6
            self.labDialogName.top = top + 5
            self.labDialogName.left = left
            self.labDialogName.width = nameRight - left
            self.labDialogContent.top = top + textOffset
            self.labDialogContent.height = height - textOffset - 3
            self.labDialogContent.left = left
            self.labDialogContent.width = right - left
            self.btnDialogExpand.top = top + 4
            self.btnDialogExpand.text = dialogExpanded and "Reduzir" or "Expandir"
        end

        local function toggleDialogExpanded()
            if not self.rectDialog.visible then return end
            dialogExpanded = not dialogExpanded
            layoutDialog(self.imgDialogAvatar.visible)
        end

        local function renderDialogText(message, speechColor)
            local options = message.talemarkOptions or {}
            local editor = self.labDialogContent
            local text = cleanMessage(message.content)
            local parsed = Firecast.parseTalemark(text, options)

            local function styleColor(name, fallback)
                local style = options[name]
                local color = style and style.color
                return type(color) == "string" and color ~= "" and color or fallback
            end

            local normalColor = styleColor("defaultTextStyle", "White")
            local function insert(text, color)
                editor:setSelectionFontColor(color)
                editor:insertText(text)
            end

            local function renderTag(tag, color)
                local kind = tag.type
                if kind == "emDashSpeech" then
                    color = speechColor or styleColor("charEmDashSpeechTextStyle", color)
                elseif kind == "charAction" then
                    color = styleColor("charActionTextStyle", "#cccccc")
                    insert("• ", color)
                elseif kind == "quotedSpeech" then
                    color = speechColor or styleColor("charQuotedSpeechTextStyle", color)
                    insert("“", color)
                elseif kind == "outOfChar" then
                    color = styleColor("outOfCharTextStyle", color)
                elseif kind == "breakline" then
                    editor:breakLine()
                    return
                end

                if tag.children and #tag.children > 0 then
                    for index, child in ipairs(tag.children) do
                        if index > 1 and kind == "root" then editor:breakLine() end
                        renderTag(child, color)
                    end
                else
                    local value = tag.text or tag.altText
                    if kind == "url" and not value then value = tag.url end
                    if value then insert(value, color) end
                end

                if kind == "quotedSpeech" then insert("”", color) end
            end

            editor.visible = true
            editor.readOnly = false
            editor:beginEdit()
            editor:selectAll()
            editor:deleteSelection()
            if parsed then
                renderTag(parsed, normalColor)
            else
                insert(text, normalColor)
            end
            editor:gotoStart()
            editor:endEdit()
            editor.readOnly = true
        end

        local function showDialog(npcName, message, avatarUrl)
            local color = npcColors[normalizeNpcName(npcName)]
            self.labDialogName.text      = npcName or ""
            self.labDialogName.fontColor = "White"
            self.rectDialog.visible      = true
            self.btnDialogExpand.visible = true

            -- Avatar
            if avatarUrl and avatarUrl ~= "" then
                setSrc(self.imgDialogAvatar, avatarUrl)
                self.imgDialogAvatar.visible = true
            else
                self.imgDialogAvatar.visible = false
            end
            layoutDialog(self.imgDialogAvatar.visible)
            renderDialogText(message, color)
        end

        -- ── Avatar do NPC e comando de chat ──────────────────────────

        -- Reutiliza a URL do sprite cadastrado como avatar da mensagem.
        local function getNpcAvatarUrl(entry)
            if entry == nil then return nil end
            if entry.slot then
                return slotUrls[entry.slot] and slotUrls[entry.slot][entry.layer] or nil
            elseif entry.extra then
                return extraUrls[entry.extra]
            end
            return nil
        end

        -- /npc <nome cadastrado> <fala>
        -- Envia a fala com o avatar e a cor cadastrados para o NPC.
        local function tratarComandoNPC(message)
            if message.command ~= "npc" then return end

            local chat = message.chat
            local mesa = message.room
            if mesa ~= nil then
                local meu = mesa.meuJogador
                if meu ~= nil and not meu.isMestre then
                    if chat then chat:escrever("[VN Scene] Você precisa do modo +mestre para falar como NPC.") end
                    message.response = { handled = true }
                    return
                end
            end

            local parameter = (message.parameter or ""):gsub("^%s*(.-)%s*$", "%1")
            if parameter == "" then
                if chat then chat:escrever("[VN Scene] Uso: /npc <nome do NPC> <fala>.") end
                message.response = { handled = true }
                return
            end

            -- Recarrega para que um NPC recém-editado possa ser usado sem espera.
            loadConfig()
            local normalized = normalizeNpcName(parameter)
            local npcKey, entry = nil, nil
            for key, candidate in pairs(npcMap) do
                if normalized:sub(1, #key + 1) == key .. " " then
                    if npcKey == nil or #key > #npcKey then
                        npcKey, entry = key, candidate
                    end
                end
            end

            if entry == nil then
                if chat then chat:escrever("[VN Scene] NPC não encontrado. Use o nome cadastrado na cena.") end
                message.response = { handled = true }
                return
            end

            local content = parameter:sub(#npcKey + 1):gsub("^%s+", "")
            if content == "" then
                if chat then chat:escrever("[VN Scene] Faltou a fala depois do nome do NPC.") end
                message.response = { handled = true }
                return
            end

            if chat == nil then
                message.response = { handled = true }
                return
            end

            local npcName = npcDisplayNames[npcKey] or parameter:sub(1, #npcKey)
            local avatarUrl = getNpcAvatarUrl(entry)
            local color = npcColors[npcKey] or DEFAULT_NPC_COLOR
            local talemarkOptions = Utils.cloneTable(chat.talemarkOptions, true) or {}
            for _, styleName in ipairs({ "charEmDashSpeechTextStyle", "charQuotedSpeechTextStyle" }) do
                local style = talemarkOptions[styleName] or {}
                style.color = color
                talemarkOptions[styleName] = style
            end

            chat:asyncSendStd(content, {
                talemarkOptions = talemarkOptions,
                impersonation = {
                    mode = "character",
                    name = npcName,
                    avatar = (avatarUrl ~= nil and avatarUrl ~= "") and avatarUrl or nil
                }
            })
            message.response = { handled = true }
        end

        local function listarComandosNPC(message)
            message.response = {
                { command = "/npc", description = "Fala como um NPC da VN Scene: /npc <nome> <fala>" }
            }
        end

        -- ── Chat ─────────────────────────────────────────────────────

        local function onChatMessage(msg)
            if sheet and sheet.listenChat == false then return end

            local logRec = msg.logRec
            if not logRec then return end
            local msgContent = logRec.msg
            if not msgContent then return end

            local impersonate = msgContent.impersonation
            if not impersonate then return end

            if impersonate.mode == "character" then
                local npcName = impersonate.name or ""
                local entry   = npcMap[normalizeNpcName(npcName)]

                if entry then
                    if entry.slot then
                        -- NPC de slot normal
                        local avatarUrl = slotUrls[entry.slot][entry.layer]
                        if sheet and sheet.keepLayerOrder == true then
                            applySlotFocus(entry.slot, entry.layer)
                        else
                            setFront(entry.slot, entry.layer)
                            applySlotOrder(entry.slot, entry.layer)
                            applySlotFocus(entry.slot)
                        end
                        self.imgExtraSprite.visible = false
                        showDialog(npcName, msgContent, avatarUrl)

                    elseif entry.extra then
                        -- Extra entra em cena no slot centro temporariamente
                        local url = extraUrls[entry.extra] or ""
                        setSrc(self.imgExtraSprite, url)
                        self.imgExtraSprite.visible = true
                        -- Escurece os slots para dar destaque ao extra
                        applySlotFocus(nil)
                        showDialog(npcName, msgContent, url)
                    end
                else
                    -- NPC não mapeado: só texto
                    self.imgExtraSprite.visible = false
                    showDialog(npcName, msgContent, nil)
                end

            elseif impersonate.mode == "narrator" then
                self.imgExtraSprite.visible  = false
                self.imgDialogAvatar.visible = false
                self.labDialogName.text      = "Narrador"
                self.labDialogName.fontColor = "#cccccc"
                self.rectDialog.visible      = true
                self.btnDialogExpand.visible = true
                layoutDialog(false)
                renderDialogText(msgContent)
                applySlotFocus(nil)
            end
        end

        -- ── Init ─────────────────────────────────────────────────────

        local function updateStageScale()
            local container = self.frmStageContainer
            if not container or container.width <= 0 or container.height <= 0 then return end

            local scale = math.min(container.width / 1280, container.height / 600)

            self.frmStage.scaleX = scale
            self.frmStage.scaleY = scale
            self.frmStage.left = math.max(0, (container.width - 1280 * scale) / 2)
            self.frmStage.top  = math.max(0, (container.height - 600 * scale) / 2)
        end

        -- Mostra a configuração na aba própria ou, no modo debug, ao lado da cena
        -- Só o dono da ficha pode editar: nega escrita a todos e libera ao dono.
        -- Quem aplica é quem tiver permissão para alterar permissões (por padrão, os mestres).
        local function enforceOwnerOnlyEdit()
            if not sheet then return end
            pcall(function()
                if not ndb.testPermission(sheet, "writePermissions") then return end
                if ndb.getPermission(sheet, "group", "todos", "write") ~= "deny" then
                    ndb.setPermission(sheet, "group", "todos", "write", "deny")
                end
                if ndb.getPermission(sheet, "group", "dono", "write") ~= "strongAllow" then
                    ndb.setPermission(sheet, "group", "dono", "write", "strongAllow")
                end
            end)
        end

        local function updateEditAccess()
            local canEdit = canEditSheet()
            self.panelConfig.enabled = canEdit
            self.chkHideConfig.enabled = canEdit
            self.chkDebugMode.enabled = canEdit
        end

        local function updateConfigTab()
            local showConfig = not (sheet and sheet.hideConfig == true)
            local debug      = sheet and sheet.debugMode == true
            local host       = self.sceneContent
            local panel      = self.panelConfig

            if debug then
                if host.width <= 0 or host.height <= 0 then return end

                if not configDocked then
                    panel.parent = host
                    configDocked = true
                end
                panel.visible = showConfig

                if host.width >= 900 then
                    panel.align = "right"
                    panel.width = math.max(360, math.min(560, host.width * 0.42))
                else
                    panel.align = "bottom"
                    panel.height = host.height * 0.5
                end

                self.tabConfig.visible = false
                self.tcMain.tabIndex = 0
            else
                if configDocked then
                    panel.parent = self.tabConfig
                    panel.align = "client"
                    panel.visible = true
                    configDocked = false
                end

                self.tabConfig.visible = showConfig
                if not showConfig then self.tcMain.tabIndex = 0 end
            end
        end

        local function updateSlotLayout()
            local container = self.slotConfigs
            if not container then return end

            local stacked = container.width < 1220
            if stacked then
                container.height = SLOT_CONFIG_HEIGHT * 3
                self.configContent.height = CONFIG_BASE_HEIGHT + SLOT_CONFIG_HEIGHT * 3
                for _, name in ipairs({"slotConfigLeft", "slotConfigCenter", "slotConfigRight"}) do
                    self[name].align = "top"
                    self[name].height = SLOT_CONFIG_HEIGHT
                end
            else
                container.height = SLOT_CONFIG_HEIGHT
                self.configContent.height = CONFIG_BASE_HEIGHT + SLOT_CONFIG_HEIGHT
                self.slotConfigLeft.align = "left"
                self.slotConfigLeft.width = 400
                self.slotConfigLeft.height = SLOT_CONFIG_HEIGHT
                self.slotConfigCenter.align = "left"
                self.slotConfigCenter.width = 400
                self.slotConfigCenter.height = SLOT_CONFIG_HEIGHT
                self.slotConfigRight.align = "left"
                self.slotConfigRight.width = 400
                self.slotConfigRight.height = SLOT_CONFIG_HEIGHT
            end
        end

        local function init()
            enforceOwnerOnlyEdit()
            updateEditAccess()
            loadConfig()
            updateSlotLayout()
            updateStageScale()
            updateConfigTab()
            if chatReceiver == nil then
                chatReceiver = Firecast.Messaging.newReceiver("ChatMessageEx", onChatMessage)
            end
            if npcCommandListener == nil then
                npcCommandListener = Firecast.Messaging.listen("HandleChatCommand", tratarComandoNPC)
            end
            if npcHelpListener == nil then
                npcHelpListener = Firecast.Messaging.listen("ListChatCommands", listarComandosNPC)
            end
        end

        local function uninit()
            if visualNpcColorForm then
                local picker = visualNpcColorForm
                visualNpcColorForm = nil
                picker:close()
            end
            if chatReceiver then
                chatReceiver:disable()
                chatReceiver = nil
            end
            if npcCommandListener then
                Firecast.Messaging.unlisten(npcCommandListener)
                npcCommandListener = nil
            end
            if npcHelpListener then
                Firecast.Messaging.unlisten(npcHelpListener)
                npcHelpListener = nil
            end
        end

        _selecionarImagem = selecionarImagem
    ]]>
    </script>

    <event name="onNodeReady">
        <![CDATA[ init() ]]>
    </event>

    <event name="onNodeUnready">
        <![CDATA[ uninit() ]]>
    </event>

    <timer name="tmrConfig"  interval="600"  enabled="false" onTimer="onConfigTimer()"/>
    <timer name="tmrFade"    interval="40"   enabled="false" onTimer="onFadeTimer()"/>
    <timer name="tmrPreview" interval="2000" enabled="false" onTimer="checkPreviews()"/>

    <!-- ── MODELOS (reduzem a repetição do XML) ── -->

    <template name="VnStageSprite">
        <image name="$(spriteName)" left="$(x)" top="0" width="337" height="456"
               style="autoFit" opacity="$(opacity)" visible="false" src=""/>
    </template>

    <template name="VnSpriteSlot">
        <VnStageSprite spriteName="imgSprite_$(slotId)_3" x="$(x3)" opacity="0.45"/>
        <VnStageSprite spriteName="imgSprite_$(slotId)_2" x="$(x2)" opacity="0.65"/>
        <VnStageSprite spriteName="imgSprite_$(slotId)_1" x="$(x1)" opacity="1.0"/>
    </template>

    <template name="VnExtraBarItem">
        <rectangle name="rectExtra_$(n)" left="$(x)"  top="4" width="58" height="48" color="#1a1535" opacity="0.9" visible="false"/>
        <image     name="imgExtra_$(n)"  left="$(xi)" top="7" width="49" height="41" style="proportional" visible="false" src=""/>
    </template>

    <template name="VnSlotRow">
        <layout align="top" height="36" margins="{bottom=$(gap)}">
            <label left="0" top="0" width="44" height="36" text="$(rowTitle)" fontSize="10" fontColor="Gray" vertTextAlign="center"/>
            <edit left="48" top="0" width="92" height="36" field="slot_$(slotId)_npc$(layerNo)" hint="Nome" onChange="scheduleLoadConfig()"/>
            <button left="144" top="0" width="44" height="36" text="Cor" canFocus="true" hint="Cor dos trechos de fala"
                    onClick="escolherCorNpc('slot_$(slotId)_color$(layerNo)')"/>
            <button left="192" top="0" width="104" height="36" text="Escolher imagem" fontSize="11" hint="Escolher imagem pelo FireDrive"
                    onClick="_selecionarImagem('slot_$(slotId)_url$(layerNo)')"/>
            <layout left="300" top="0" width="36" height="36">
                <image name="imgPreview_$(slotId)_$(layerNo)" align="client" style="proportional" src=""/>
                <label name="labPreviewErr_$(slotId)_$(layerNo)" align="client" text="!" fontSize="18" fontStyle="bold"
                       fontColor="#ff5555" horzTextAlign="center" vertTextAlign="center" visible="false"
                       hint="A imagem não carregou. Confira a imagem selecionada."/>
            </layout>
            <button left="340" top="0" width="28" height="36" text="★" hint="Definir esta camada como a da frente (foco)" onClick="setFocus('$(slotId)', $(layerNo))"/>
            <button left="372" top="0" width="28" height="36" text="X" hint="Limpar nome, imagem e cor deste NPC"
                    onClick="clearSlotNpc('$(slotId)', $(layerNo))"/>
        </layout>
    </template>

    <template name="VnSlotConfig">
        <layout name="slotConfig$(slotName)" align="$(boxAlign)" width="400" height="152" margins="{right=$(boxGap)}">
            <layout align="top" height="20" margins="{bottom=4}">
                <label text="$(slotTitle)" align="left" width="70" fontSize="11" fontStyle="bold" vertTextAlign="center"/>
                <button align="right" width="52" height="20" text="Limpar" fontSize="10" margins="{left=4}"
                        hint="Apaga nomes, cores e imagens deste slot" onClick="confirmClearSlot('$(slotId)')"/>
                <button align="right" width="52" height="20" text="Girar" fontSize="10" margins="{left=4}"
                        hint="Gira as camadas: a da frente vai para trás, e Meio e Atrás sobem" onClick="rotateSlot('$(slotId)')"/>
                <checkBox align="client" field="slot_$(slotId)_visible" text="Visível" hint="Mostra este slot na cena" margins="{left=4}" onChange="loadConfig()"/>
            </layout>
            <VnSlotRow slotId="$(slotId)" layerNo="1" rowTitle="Frente" gap="4"/>
            <VnSlotRow slotId="$(slotId)" layerNo="2" rowTitle="Meio"   gap="4"/>
            <VnSlotRow slotId="$(slotId)" layerNo="3" rowTitle="Atrás"  gap="12"/>
        </layout>
    </template>

    <template name="VnExtraRow">
        <layout align="top" height="36" margins="{bottom=$(gap)}">
            <edit align="left" width="100" field="extra_$(n)_npc" hint="Extra $(n)" margins="{right=4}" onChange="scheduleLoadConfig()"/>
            <button align="left" width="52" text="Cor" canFocus="true" hint="Cor dos trechos de fala" margins="{right=4}"
                    onClick="escolherCorNpc('extra_$(n)_color')"/>
            <button align="client" height="36" text="Escolher imagem" hint="Escolher imagem pelo FireDrive" margins="{right=4}"
                    onClick="_selecionarImagem('extra_$(n)_url')"/>
            <layout align="right" width="36" height="36">
                <image name="imgPreviewExtra_$(n)" align="client" style="proportional" src=""/>
                <label name="labPreviewErrExtra_$(n)" align="client" text="!" fontSize="18" fontStyle="bold"
                       fontColor="#ff5555" horzTextAlign="center" vertTextAlign="center" visible="false"
                       hint="A imagem não carregou. Confira a imagem selecionada."/>
            </layout>
        </layout>
    </template>

    <template name="VnSceneRow">
        <layout align="top" height="28" margins="{bottom=4}">
            <edit align="client" field="scene_$(n)_name" hint="Nome da cena $(n)" margins="{right=4}"/>
            <button align="right" width="60" text="Apagar" fontSize="10" margins="{left=4}"
                    hint="Apaga esta cena salva" onClick="confirmDeleteScene($(n))"/>
            <button align="right" width="64" text="Carregar" fontSize="10" margins="{left=4}"
                    hint="Substitui a configuração atual por esta cena" onClick="confirmLoadScene($(n))"/>
            <button align="right" width="56" text="Salvar" fontSize="10" margins="{left=4}"
                    hint="Guarda a configuração atual nesta cena" onClick="confirmSaveScene($(n))"/>
        </layout>
    </template>

    <tabControl align="client" name="tcMain" tabIndex="0">

    <!-- ── ABA DA CENA ── -->
    <tab title="Cena">
    <layout align="client" name="sceneContent" onResize="updateConfigTab()">
    <layout align="bottom" height="24" margins="{left=8, right=8, top=4, bottom=4}">
        <checkBox name="chkHideConfig" align="left" width="190" field="hideConfig" text="Ocultar Configuração"
                  hint="Esconde a configuração (útil para jogadores)"
                  onChange="updateConfigTab()"/>
        <checkBox name="chkDebugMode" align="left" width="340" field="debugMode" text="Modo debug (cena e configuração lado a lado)"
                  hint="Mostra a configuração ao lado da cena, sem trocar de aba"
                  onChange="updateConfigTab()"/>
    </layout>
    <!-- ── CANVAS DA CENA (sempre visível) ── -->
    <layout align="client" name="frmStageContainer" onResize="updateStageScale()">
        <layout left="0" top="0" width="1280" height="600" name="frmStage">

            <image name="imgBackground" left="0" top="0" width="1280" height="600" style="stretch" src=""/>

            <VnSpriteSlot slotId="left"   x1="55"  x2="31"  x3="7"/>
            <VnSpriteSlot slotId="center" x1="471" x2="453" x3="489"/>
            <VnSpriteSlot slotId="right"  x1="888" x2="912" x3="936"/>

            <VnStageSprite spriteName="imgExtraSprite" x="471" opacity="1.0"/>

            <rectangle name="rectExtrasBar" left="0" top="456" width="1280" height="56" color="#0a0820" opacity="0.75" visible="false"/>
            <rectangle name="rectDialog" left="0" top="456" width="1280" height="144" color="#0a0820" opacity="0.88" visible="false"/>
            <layout name="layExtras" left="443" top="456" width="394" height="56" visible="false">
                <VnExtraBarItem n="1" x="0"   xi="5"/>
                <VnExtraBarItem n="2" x="67"  xi="72"/>
                <VnExtraBarItem n="3" x="134" xi="139"/>
                <VnExtraBarItem n="4" x="201" xi="206"/>
                <VnExtraBarItem n="5" x="268" xi="273"/>
                <VnExtraBarItem n="6" x="335" xi="340"/>
            </layout>
            <image name="imgDialogAvatar" left="38" top="462" width="132" height="132" style="proportional" visible="false" src=""/>
            <label name="labDialogName"    left="35" top="461" width="1125" height="22" text="" fontColor="White" fontSize="13" fontStyle="bold"/>
            <richEdit name="labDialogContent" left="35" top="485" width="1125" height="112" visible="false"
                      readOnly="true" showToolbar="false" canFocus="false" hitTest="false"
                      defaultFontColor="White" defaultFontSize="12" backgroundColor="#00000000"/>
            <button name="btnDialogExpand" left="1170" top="460" width="90" height="20"
                    text="Expandir" fontSize="9" visible="false"
                    hint="Expande ou reduz a caixa de diálogo"
                    onClick="toggleDialogExpanded()"/>

    </layout>
    </layout>
    </layout>
    </tab>

    <!-- ── ABA DE CONFIGURAÇÃO ── -->
    <tab title="Configuração" name="tabConfig">
    <layout align="client" name="panelConfig">
        <scrollBox align="client">
            <layout name="configContent" align="top" height="1220"
                    margins="{left=12, right=12, top=12, bottom=12}">

                <!-- Botões de ação -->
                <button align="top" height="28" text="🗑 Limpar tudo (nomes e imagens)"
                        hint="Apaga toda a configuração da cena (pede confirmação)"
                        margins="{bottom=8}"
                        onClick="confirmClearConfig()"/>
                <label text="Imagem de Fundo" align="top" height="20"
                       fontStyle="bold" fontSize="13"/>
                <layout align="top" height="28" margins="{bottom=16}">
                    <button align="client" text="Escolher imagem" hint="Escolher imagem pelo FireDrive"
                            onClick="_selecionarImagem('bgUrl')"/>
                </layout>
                <checkBox align="top" height="24" field="listenChat" checked="true"
                          text="Atualizar a cena com mensagens do chat"
                          hint="Quando ligado, as falas do chat atualizam sprites e diálogo"
                          margins="{bottom=8}"/>
                <checkBox align="top" height="24" field="keepLayerOrder"
                          text="Manter a ordem das camadas quando alguém fala"
                          hint="Ligado: o personagem que fala é destacado onde está, sem ir para a frente"
                          margins="{bottom=8}"/>
                <label name="labConfigWarning" align="top" height="18" visible="false"
                       fontSize="10" fontColor="#d66" wordWrap="true" margins="{bottom=8}"/>

                <!-- SLOTS -->
                <label text="Slots de Personagem" align="top" height="20"
                       fontStyle="bold" fontSize="13"/>
                <label text="Como funciona: o Nome cadastrado precisa ser igual ao nome do personagem usado no chat (maiúsculas e minúsculas não importam; espaços nas pontas são ignorados)."
                       align="top" height="30" fontSize="10" fontColor="Gray" wordWrap="true" margins="{bottom=2}"/>
                <label text="Quando esse personagem fala, a cena destaca o sprite dele e mostra a fala. Mensagens do Narrador só mostram o texto."
                       align="top" height="30" fontSize="10" fontColor="Gray" wordWrap="true" margins="{bottom=2}"/>
                <label text="Cada slot tem 3 camadas (Frente, Meio, Atrás). Use ★ para escolher a camada em foco."
                       align="top" height="18" fontSize="10" fontColor="Gray" wordWrap="true" margins="{bottom=8}"/>

                <layout name="slotConfigs" align="top" height="152" onResize="updateSlotLayout()">
                    <VnSlotConfig slotName="Left"   slotId="left"   slotTitle="Esquerda" boxAlign="left"   boxGap="8"/>
                    <VnSlotConfig slotName="Center" slotId="center" slotTitle="Centro"   boxAlign="left"   boxGap="8"/>
                    <VnSlotConfig slotName="Right"  slotId="right"  slotTitle="Direita"  boxAlign="left"   boxGap="0"/>
                </layout>

                <!-- Extras -->
                <label text="Personagens Extras" align="top" height="20" fontStyle="bold" fontSize="13"/>
                <label text="Quando falam, aparecem no centro temporariamente."
                       align="top" height="18" fontSize="11" fontColor="Gray" margins="{bottom=8}"/>
                <layout align="top" height="18" margins="{bottom=4}">
                    <label text="Nome" align="left" width="100" fontSize="10" fontColor="Gray"/>
                    <label text="Cor" align="left" width="52" fontSize="10" fontColor="Gray" margins="{left=4}"/>
                    <label text="Imagem" align="client" fontSize="10" fontColor="Gray" margins="{left=4}"/>
                    <label text="Prev" align="right" width="36" fontSize="10" fontColor="Gray" horzTextAlign="center"/>
                </layout>
                <VnExtraRow n="1" gap="6"/>
                <VnExtraRow n="2" gap="6"/>
                <VnExtraRow n="3" gap="6"/>
                <VnExtraRow n="4" gap="6"/>
                <VnExtraRow n="5" gap="6"/>
                <VnExtraRow n="6" gap="16"/>

                <!-- Cenas salvas e transferência -->
                <label text="Cenas Salvas" align="top" height="20" fontStyle="bold" fontSize="13"/>
                <label text="Guarde a configuração atual (fundo, slots e extras) com um nome e volte a ela depois."
                       align="top" height="18" fontSize="11" fontColor="Gray" margins="{bottom=8}"/>
                <VnSceneRow n="1"/>
                <VnSceneRow n="2"/>
                <VnSceneRow n="3"/>
                <VnSceneRow n="4"/>
                <VnSceneRow n="5"/>
                <VnSceneRow n="6"/>

                <label text="Exportar e Importar" align="top" height="20" fontStyle="bold" fontSize="13" margins="{top=12}"/>
                <label text="Copia a configuração atual como texto, ou aplica um texto copiado de outra ficha."
                       align="top" height="18" fontSize="11" fontColor="Gray" margins="{bottom=8}"/>
                <layout align="top" height="28">
                    <button align="left" width="180" text="Exportar (copiar)" margins="{right=8}"
                            hint="Copia a configuração atual para a área de transferência" onClick="exportConfig()"/>
                    <button align="left" width="180" text="Importar (colar)"
                            hint="Aplica a configuração que está na área de transferência" onClick="importConfig()"/>
                </layout>

            </layout>
        </scrollBox>
    </layout>

    </tab>
    </tabControl>

</form>
