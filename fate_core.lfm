<?xml version="1.0" encoding="UTF-8"?>
<form name="frmFateCore"
      formType="sheetTemplate"
      dataType="br.GodsCorpse.FateCore"
      title="Fate Core">

    <script>
    <![CDATA[
        require("firecast.lua");

        -- ── Constantes de configuração padrão ────────────────────────
        local DEFAULT_ESCADA_MAX  = 5   -- topo da escada (+5)
        local DEFAULT_ESCADA_MIN  = 1   -- base (+1)
        local DEFAULT_ASPECTOS    = 3   -- aspectos livres
        local DEFAULT_FACANHAS    = 6   -- linhas de façanhas
        local DEFAULT_EXTRAS_L    = 6   -- linhas de extras (lista)
        local DEFAULT_FISICO      = 4   -- caixas de estresse físico (total)
        local DEFAULT_MENTAL      = 4   -- caixas de estresse mental (total)
        local DEFAULT_CSE         = true -- consequência suave extra

        -- Nomes dos níveis da escada (índice = bônus)
        local NIVEL = {
            [0] = "Medíocre",
            [1] = "Regular",
            [2] = "Razoável",
            [3] = "Bom",
            [4] = "Ótimo",
            [5] = "Excepcional",
            [6] = "Fantástico",
            [7] = "Épico",
            [8] = "Lendário",
        }

        -- ── Rolagem de dado Fate ─────────────────────────────────────

        local function rolarFate(nomePericia, bonus)
            local room = Firecast.getRoomOf(sheet)
            if not room then return end

            local bonusNum = tonumber(bonus) or 0
            local expr = "4dF"
            if bonusNum > 0 then
                expr = "4dF + " .. bonusNum
            elseif bonusNum < 0 then
                expr = "4dF - " .. math.abs(bonusNum)
            end

            local msg = nomePericia ~= "" and nomePericia or "Perícia"
            async(function()
                await(room.chat:asyncRoll(expr, msg))
            end)
        end

        -- ── Atualiza a escada de perícias dinamicamente ───────────────

        local function atualizarEscada()
            local node    = sheet
            local maxNiv  = tonumber(node and node.cfg_escadaMax) or DEFAULT_ESCADA_MAX
            local minNiv  = tonumber(node and node.cfg_escadaMin) or DEFAULT_ESCADA_MIN

            -- Mostra/oculta linhas da escada conforme configuração
            for nivel = 0, 8 do
                local visivel = (nivel >= minNiv and nivel <= maxNiv)
                local row = self["rowNivel_" .. nivel]
                if row then row.visible = visivel end
            end
        end

        -- ── Atualiza caixas de estresse ───────────────────────────────

        local function atualizarEstresse()
            local node    = sheet
            local fisico  = tonumber(node and node.cfg_fisico)  or DEFAULT_FISICO
            local mental  = tonumber(node and node.cfg_mental)  or DEFAULT_MENTAL

            for i = 1, 8 do
                local chkF = self["chkFisico_" .. i]
                local chkM = self["chkMental_" .. i]
                if chkF then
                    chkF.visible = (i <= fisico)
                end
                if chkM then
                    chkM.visible = (i <= mental)
                end
            end
        end

        -- ── Atualiza consequência suave extra ─────────────────────────

        local function atualizarConsequencias()
            local node = sheet
            local cse  = (node and node.cfg_cse) == true
            local rowCSE = self["rowConsCSExtra"]
            if rowCSE then rowCSE.visible = cse end
        end

        -- ── Atualiza linhas de façanhas ───────────────────────────────

        local function atualizarFacanhas()
            local node = sheet
            local n    = tonumber(node and node.cfg_facanhas) or DEFAULT_FACANHAS
            for i = 1, 10 do
                local row = self["rowFacanha_" .. i]
                if row then row.visible = (i <= n) end
            end
        end

        -- ── Atualiza linhas de extras (lista) ────────────────────────

        local function atualizarExtrasLista()
            local node = sheet
            local n    = tonumber(node and node.cfg_extrasL) or DEFAULT_EXTRAS_L
            for i = 1, 10 do
                local row = self["rowExtraL_" .. i]
                if row then row.visible = (i <= n) end
            end
        end

        -- ── Atualiza aspectos livres ──────────────────────────────────

        local function atualizarAspectos()
            local node = sheet
            local n    = tonumber(node and node.cfg_aspectos) or DEFAULT_ASPECTOS
            for i = 1, 7 do
                local row = self["rowAspecto_" .. i]
                if row then row.visible = (i <= n) end
            end
        end

        -- ── Aplica todas as configurações ─────────────────────────────

        local function aplicarConfig()
            atualizarEscada()
            atualizarEstresse()
            atualizarConsequencias()
            atualizarFacanhas()
            atualizarExtrasLista()
            atualizarAspectos()
        end
    ]]>
    </script>

    <event name="onNodeReady">
        <![CDATA[ aplicarConfig() ]]>
    </event>

    <tabControl align="client" name="tcMain">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ABA 1 — FICHA                                             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <tab title="Ficha">
            <scrollBox align="client">
                <layout align="client" margins="{left=10, right=10, top=10, bottom=10}">

                    <!-- ── Cabeçalho ── -->
                    <layout align="top" height="52" margins="{bottom=8}">
                        <layout align="client" margins="{right=8}">
                            <label text="Nome" align="top" height="14"
                                   fontSize="8" fontColor="Gray" fontStyle="bold"/>
                            <edit align="client" field="nome" fontSize="13"/>
                        </layout>
                        <layout align="right" width="160">
                            <layout align="client" margins="{right=8}">
                                <label text="Jogador" align="top" height="14"
                                       fontSize="8" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="jogador" fontSize="11"/>
                            </layout>
                            <layout align="right" width="72">
                                <layout align="left" width="34" margins="{right=4}">
                                    <label text="Recarga" align="top" height="14"
                                           fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                    <edit align="client" field="recarga"
                                          horzTextAlign="center" fontSize="13"/>
                                </layout>
                                <layout align="client">
                                    <label text="P. Destino" align="top" height="14"
                                           fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                    <edit align="client" field="pontosDestino"
                                          horzTextAlign="center" fontSize="13"/>
                                </layout>
                            </layout>
                        </layout>
                    </layout>

                    <!-- ── Corpo principal: Perícias | Retrato+Aspectos ── -->
                    <layout align="top" height="340" margins="{bottom=8}">

                        <!-- Escada de Perícias -->
                        <layout align="left" width="260" margins="{right=8}">
                            <label text="Perícias" align="top" height="18"
                                   fontSize="9" fontColor="Gray" fontStyle="bold"
                                   margins="{bottom=4}"/>
                            <layout align="client">

                                <!-- Nível +8 -->
                                <layout align="top" height="52" name="rowNivel_8" visible="false" margins="{bottom=2}">
                                    <label text="+8" align="left" width="24" fontSize="9" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Lendário" align="left" width="52" fontSize="7" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=2}">
                                            <edit align="client" field="per8_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per8_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per8_1.text, self.per8_1v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +7 -->
                                <layout align="top" height="52" name="rowNivel_7" visible="false" margins="{bottom=2}">
                                    <label text="+7" align="left" width="24" fontSize="9" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Épico" align="left" width="52" fontSize="7" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=2}">
                                            <edit align="client" field="per7_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per7_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per7_1.text, self.per7_1v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +6 -->
                                <layout align="top" height="52" name="rowNivel_6" visible="false" margins="{bottom=2}">
                                    <label text="+6" align="left" width="24" fontSize="9" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Fantástico" align="left" width="52" fontSize="7" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=2}">
                                            <edit align="client" field="per6_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per6_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per6_1.text, self.per6_1v.text)"/>
