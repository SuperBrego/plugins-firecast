                                    <label text="Excepcional" align="left" width="52" fontSize="7" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <edit align="client" field="per5_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                        <edit align="right" width="24" field="per5_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                        <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per5_1.text, self.per5_1v.text)"/>
                                    </layout>
                                </layout>

                                <!-- Nível +4 — 2 slots -->
                                <layout align="top" height="56" name="rowNivel_4" margins="{bottom=2}">
                                    <label text="+4" align="left" width="24" fontSize="9" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Ótimo" align="left" width="52" fontSize="7" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per4_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per4_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per4_1.text, self.per4_1v.text)"/>
                                        </layout>
                                        <layout align="top" height="24">
                                            <edit align="client" field="per4_2" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per4_2v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per4_2.text, self.per4_2v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +3 — 3 slots -->
                                <layout align="top" height="84" name="rowNivel_3" margins="{bottom=2}">
                                    <label text="+3" align="left" width="24" fontSize="9" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Bom" align="left" width="52" fontSize="7" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per3_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per3_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per3_1.text, self.per3_1v.text)"/>
                                        </layout>
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per3_2" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per3_2v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per3_2.text, self.per3_2v.text)"/>
                                        </layout>
                                        <layout align="top" height="24">
                                            <edit align="client" field="per3_3" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per3_3v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per3_3.text, self.per3_3v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +2 — 4 slots -->
                                <layout align="top" height="112" name="rowNivel_2" margins="{bottom=2}">
                                    <label text="+2" align="left" width="24" fontSize="9" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Razoável" align="left" width="52" fontSize="7" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=4}">
