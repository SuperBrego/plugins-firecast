<?xml version="1.0" encoding="UTF-8"?>
<form name="frmFateCore"
      formType="sheetTemplate"
      dataType="br.GodsCorpse.FateCore"
      title="Fate Core">

    <script>
    <![CDATA[
        require("firecast.lua");
        local Async = require("async.lua");

        -- Configuração padrão
        local DEFAULT_FISICO      = 4   -- caixas de estresse físico (total)
        local DEFAULT_MENTAL      = 4   -- caixas de estresse mental (total)
        -- Rolagem de dado Fate

        local function rolarFate(nomePericia, bonus)
            local room = Firecast.getRoomOf(sheet)
            if not room then return end

            local bonusNum = tonumber(bonus) or 0
            local expr = "4dF"
            if bonusNum > 0 then
                expr = "4dF + " .. bonusNum
            elseif bonusNum < 0 then
                expr = "4dF - " .. math.abs(bonusNum)
            end

            local msg = nomePericia ~= "" and nomePericia or "Perícia"
            Async.execute(function()
                await(room.chat:asyncRoll(expr, msg))
            end)
        end

        -- Atualiza caixas de estresse

        local function atualizarEstresse()
            local node    = sheet
            local fisico  = tonumber(node and node.cfg_fisico)  or DEFAULT_FISICO
            local mental  = tonumber(node and node.cfg_mental)  or DEFAULT_MENTAL

            for i = 1, 8 do
                for _, prefixo in ipairs({"chkFisico_", "chkFisicoTopo_"}) do
                    local chkF = self[prefixo .. i]
                    if chkF then chkF.visible = (i <= fisico) end
                end
                for _, prefixo in ipairs({"chkMental_", "chkMentalTopo_"}) do
                    local chkM = self[prefixo .. i]
                    if chkM then chkM.visible = (i <= mental) end
                end
            end
        end

        -- Atualiza consequência suave extra

        local function atualizarConsequencias()
            local node = sheet
            local cse  = (node and node.cfg_cse) == true
            local rowCSE = self["rowConsCSExtra"]
            if rowCSE then rowCSE.visible = cse end
            local rowCSETopo = self["rowConsCSExtraTopo"]
            if rowCSETopo then rowCSETopo.visible = cse end
        end

        local niveisPericia = {
            [0] = "Medíocre", [1] = "Regular", [2] = "Razoável",
            [3] = "Bom", [4] = "Ótimo", [5] = "Excepcional",
            [6] = "Fantástico", [7] = "Épico", [8] = "Lendário"
        }

        local function atualizarNivelPericia(i)
            local valor = tonumber(sheet and sheet["pericia" .. i .. "_valor"])
            local nivel = self["nivelPericia_" .. i]
            if nivel then
                local texto = valor and niveisPericia[valor] or ""
                nivel.text = texto
                nivel.fontColor = texto ~= "" and "#C97A85" or "Gray"
                nivel.fontStyle = texto ~= "" and "bold" or ""
            end
        end

        local function atualizarPericias()
            if not sheet then return end
            local existePericia = false
            local ultimaPericia = 0
            for i = 1, 16 do
                existePericia = existePericia or sheet["pericia" .. i .. "_ativa"] == true
                if sheet["pericia" .. i .. "_ativa"] == true then ultimaPericia = i end
            end
            if not existePericia then
                for i = 1, 4 do sheet["pericia" .. i .. "_ativa"] = true end
            end
            for i = 1, 16 do
                local row = self["rowPericia_" .. i]
                if row then row.visible = sheet["pericia" .. i .. "_ativa"] == true end
                atualizarNivelPericia(i)
            end
            local corpo = self["corpoPrincipal"]
            if corpo then corpo.height = 560 end
            local lista = self["listaPericiasFacanhas"]
            if lista then lista.height = math.max(600, 70 + ultimaPericia * 57) end
        end

        local function atualizarFacanhas()
            if not sheet then return end
            local existeFacanha = false
            for i = 1, 10 do existeFacanha = existeFacanha or sheet["facanha" .. i .. "_ativa"] == true end
            if not existeFacanha then
                for i = 1, 3 do sheet["facanha" .. i .. "_ativa"] = true end
            end
            for i = 1, 10 do
                local row = self["rowFacanha_" .. i]
                if row then row.visible = sheet["facanha" .. i .. "_ativa"] == true end
            end
        end

        local function adicionarFacanha()
            if not sheet then return end
            for i = 1, 10 do
                if sheet["facanha" .. i .. "_ativa"] ~= true then
                    sheet["facanha" .. i .. "_ativa"] = true
                    atualizarFacanhas()
                    return
                end
            end
        end

        local function removerFacanha(i)
            if not sheet then return end
            sheet["facanha" .. i .. "_ativa"] = false
            atualizarFacanhas()
        end

        local function adicionarPericia()
            if not sheet then return end
            for i = 1, 16 do
                if sheet["pericia" .. i .. "_ativa"] ~= true then
                    sheet["pericia" .. i .. "_ativa"] = true
                    atualizarPericias()
                    return
                end
            end
        end

        local function removerPericia(i)
            if not sheet then return end
            sheet["pericia" .. i .. "_ativa"] = false
            atualizarPericias()
        end

        local function atualizarExtras()
            if not sheet then return end
            for i = 1, 6 do
                local row = self["rowExtraD_" .. i]
                if row then
                    row.visible = sheet["extraD" .. i .. "_ativo"] == true
                    if i <= 3 then
                        row.height = sheet["extraD" .. i .. "_expandido"] == true and 380 or 240
                    end
                end
            end
        end

        local function adicionarExtra()
            if not sheet then return end
            for i = 1, 6 do
                if sheet["extraD" .. i .. "_ativo"] ~= true then
                    sheet["extraD" .. i .. "_ativo"] = true
                    atualizarExtras()
                    return
                end
            end
        end

        local function removerExtra(i)
            if not sheet then return end
            sheet["extraD" .. i .. "_ativo"] = false
            sheet["extraD" .. i .. "_nome"] = nil
            sheet["extraD" .. i .. "_perm"] = nil
            sheet["extraD" .. i .. "_custo"] = nil
            sheet["extraD" .. i .. "_desc"] = nil
            atualizarExtras()
        end

        local function alternarDescricaoExtra(i)
            if not sheet then return end
            local expandido = sheet["extraD" .. i .. "_expandido"] == true
            sheet["extraD" .. i .. "_expandido"] = not expandido
            local row = self["rowExtraD_" .. i]
            if row then row.height = expandido and 240 or 380 end
        end

        local function atualizarDicaRetrato()
            local dica = self["dicaRetrato"]
            local imagem = self["imgRetrato"]
            if dica then
                local url = imagem and imagem.imageURL
                dica.visible = url == nil or url == ""
            end
        end

        local function removerRetrato()
            if not sheet then return end
            sheet.retrato = nil
            local imagem = self["imgRetrato"]
            if imagem then imagem.imageURL = "" end
            atualizarDicaRetrato()
        end

        local function aplicarModoCompacto()
            if not sheet then return end
            local compacto = sheet.cfg_compacto == true
            local descricao = self["secaoDescricaoPessoal"]
            local recursos = self["secaoRecursosPessoal"]
            local conteudo = self["conteudoPessoal"]

            if descricao then descricao.visible = not compacto end
            if recursos then recursos.visible = not compacto end
            if conteudo then conteudo.height = compacto and 230 or 1110 end

            local margemCartao = compacto and {left=4, right=4, top=4, bottom=4} or {left=8, right=8, top=8, bottom=8}
            for _, nome in ipairs({"paddingAspectos", "paddingPericias", "paddingFacanhas"}) do
                local painel = self[nome]
                if painel then painel.margins = margemCartao end
            end
            local ficha = self["conteudoFicha"]
            if ficha then ficha.margins = compacto and {left=6, right=6, top=6, bottom=6} or {left=10, right=10, top=10, bottom=10} end
        end

        local function aplicarTemaVisual()
            if not sheet then return end
            if sheet.cfg_tema == nil or sheet.cfg_tema == "" then sheet.cfg_tema = "grafite" end
            local tema = sheet.cfg_tema
            local corCartao, corBorda, opacidade = "#242328", "#4F2930", 0.12
            if tema == "classico" then
                corCartao, corBorda, opacidade = "#342C25", "#8C7252", 0.05
            elseif tema == "contraste" then
                corCartao, corBorda, opacidade = "#151515", "#E4C2C6", 0
            end

            local nomesCartao = {
                "cardCabecalho", "cardEstado", "cardAspectos",
                "cardPericias", "cardFacanhas",
                "cardExtra1", "cardExtra2", "cardExtra3",
                "cardExtra4", "cardExtra5", "cardExtra6",
                "cardPessoalIdent", "cardPessoalDescricao", "cardPessoalRecursos"
            }
            for _, nome in ipairs(nomesCartao) do
                local cartao = self[nome]
                if cartao then
                    cartao.color = corCartao
                    cartao.strokeColor = corBorda
                end
            end
            for _, nome in ipairs({"texturaFicha", "texturaExtras", "texturaPessoal", "texturaConfiguracao"}) do
                local textura = self[nome]
                if textura then textura.opacity = opacidade end
            end
        end

        -- Aplica todas as configurações

        local function aplicarConfig()
            atualizarEstresse()
            atualizarConsequencias()
            atualizarPericias()
            atualizarFacanhas()
            atualizarExtras()
            atualizarDicaRetrato()
            aplicarModoCompacto()
            aplicarTemaVisual()
        end
    ]]>
    </script>

    <event name="onNodeReady">
        <![CDATA[ aplicarConfig() ]]>
    </event>

    <tabControl align="client" name="tcMain">

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ABA 1 — FICHA                                             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <tab title="Ficha">
            <layout align="client">
                <image name="texturaFicha" align="client" src="assets/fate-textura-grafite.png" style="stretch" opacity="0.12"/>
                <scrollBox align="client">
                <layout name="conteudoFicha" align="top" height="2200" margins="{left=10, right=10, top=10, bottom=10}">

                    <!-- ── Cabeçalho ── -->
                    <layout align="top" height="58" margins="{bottom=10}">
                        <layout align="client">
                        <rectangle name="cardCabecalho" align="client" color="#242328" strokeColor="#4F2930" strokeSize="1"/>
                        <layout align="client" margins="{left=8, right=8, top=8, bottom=8}">
                        <layout align="client" margins="{right=8}">
                            <label text="NOME DO PERSONAGEM" align="top" height="18"
                                   fontSize="11" fontColor="#C97A85" fontStyle="bold"/>
                            <edit align="client" field="nome" fontSize="15"/>
                        </layout>
                        <layout align="right" width="120">
                            <layout align="left" width="56" margins="{right=8}">
                                <label text="RECARGA" align="top" height="18"
                                       fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                <edit align="client" field="recarga"
                                      horzTextAlign="center" fontSize="15"/>
                            </layout>
                            <layout align="client">
                                <label text="P. DESTINO" align="top" height="18"
                                       fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                <edit align="client" field="pontosDestino"
                                      horzTextAlign="center" fontSize="15"/>
                            </layout>
                        </layout>
                        </layout>
                        </layout>
                    </layout>

                    <!-- ── Corpo principal: Perícias | Retrato+Aspectos ── -->
                    <layout name="corpoPrincipal" align="top" height="560" margins="{bottom=10}">

                        <!-- Escada de Perícias -->
                        <layout align="left" width="260" visible="false" margins="{right=8}">
                            <label text="Perícias" align="top" height="18"
                                   fontSize="11" fontColor="Gray" fontStyle="bold"
                                   margins="{bottom=4}"/>
                            <layout align="client">

                                <!-- Nível +8 -->
                                <layout align="top" height="52" name="rowNivel_8" visible="false" margins="{bottom=2}">
                                    <label text="+8" align="left" width="24" fontSize="11" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Lendário" align="left" width="52" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=2}">
                                            <edit align="client" field="per8_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per8_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per8_1.text, self.per8_1v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +7 -->
                                <layout align="top" height="52" name="rowNivel_7" visible="false" margins="{bottom=2}">
                                    <label text="+7" align="left" width="24" fontSize="11" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Épico" align="left" width="52" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=2}">
                                            <edit align="client" field="per7_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per7_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per7_1.text, self.per7_1v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +6 -->
                                <layout align="top" height="52" name="rowNivel_6" visible="false" margins="{bottom=2}">
                                    <label text="+6" align="left" width="24" fontSize="11" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Fantástico" align="left" width="52" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=2}">
                                            <edit align="client" field="per6_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per6_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per6_1.text, self.per6_1v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +5 — 1 slot -->
                                <layout align="top" height="28" name="rowNivel_5" margins="{bottom=2}">
                                    <label text="+5" align="left" width="24" fontSize="11" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Excepcional" align="left" width="52" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <edit align="client" field="per5_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                        <edit align="right" width="24" field="per5_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                        <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per5_1.text, self.per5_1v.text)"/>
                                    </layout>
                                </layout>

                                <!-- Nível +4 — 2 slots -->
                                <layout align="top" height="56" name="rowNivel_4" margins="{bottom=2}">
                                    <label text="+4" align="left" width="24" fontSize="11" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Ótimo" align="left" width="52" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per4_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per4_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per4_1.text, self.per4_1v.text)"/>
                                        </layout>
                                        <layout align="top" height="24">
                                            <edit align="client" field="per4_2" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per4_2v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per4_2.text, self.per4_2v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +3 — 3 slots -->
                                <layout align="top" height="84" name="rowNivel_3" margins="{bottom=2}">
                                    <label text="+3" align="left" width="24" fontSize="11" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Bom" align="left" width="52" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per3_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per3_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per3_1.text, self.per3_1v.text)"/>
                                        </layout>
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per3_2" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per3_2v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per3_2.text, self.per3_2v.text)"/>
                                        </layout>
                                        <layout align="top" height="24">
                                            <edit align="client" field="per3_3" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per3_3v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per3_3.text, self.per3_3v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +2 — 4 slots -->
                                <layout align="top" height="112" name="rowNivel_2" margins="{bottom=2}">
                                    <label text="+2" align="left" width="24" fontSize="11" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Razoável" align="left" width="52" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per2_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per2_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per2_1.text, self.per2_1v.text)"/>
                                        </layout>
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per2_2" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per2_2v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per2_2.text, self.per2_2v.text)"/>
                                        </layout>
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per2_3" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per2_3v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per2_3.text, self.per2_3v.text)"/>
                                        </layout>
                                        <layout align="top" height="24">
                                            <edit align="client" field="per2_4" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per2_4v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per2_4.text, self.per2_4v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                                <!-- Nível +1 — 5 slots -->
                                <layout align="top" height="140" name="rowNivel_1" margins="{bottom=2}">
                                    <label text="+1" align="left" width="24" fontSize="11" fontColor="#b9151f" fontStyle="bold" vertTextAlign="center" horzTextAlign="trailing" margins="{right=4}"/>
                                    <label text="Regular" align="left" width="52" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{right=4}"/>
                                    <layout align="client">
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per1_1" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per1_1v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per1_1.text, self.per1_1v.text)"/>
                                        </layout>
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per1_2" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per1_2v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per1_2.text, self.per1_2v.text)"/>
                                        </layout>
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per1_3" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per1_3v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per1_3.text, self.per1_3v.text)"/>
                                        </layout>
                                        <layout align="top" height="24" margins="{bottom=4}">
                                            <edit align="client" field="per1_4" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per1_4v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per1_4.text, self.per1_4v.text)"/>
                                        </layout>
                                        <layout align="top" height="24">
                                            <edit align="client" field="per1_5" hint="perícia" fontSize="10" margins="{right=2}"/>
                                            <edit align="right" width="24" field="per1_5v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="10" onClick="rolarFate(self.per1_5.text, self.per1_5v.text)"/>
                                        </layout>
                                    </layout>
                                </layout>

                            </layout>
                        </layout>

                        <!-- Perícias adicionáveis -->


                        <!-- Aspectos -->
                        <layout align="client">
                            <rectangle name="cardAspectos" align="client" color="#242328" strokeColor="#4F2930" strokeSize="1"/>
                            <layout name="paddingAspectos" align="client" margins="{left=8, right=8, top=8, bottom=8}">

                            <!-- Retrato, estresse e consequências -->
                            <layout align="top" height="280" margins="{bottom=12}">
                                <layout align="client">
                                <rectangle name="cardEstado" align="client" color="#201F24" strokeColor="#503038" strokeSize="1"/>
                                <layout align="client" margins="{left=10, right=10, top=10, bottom=10}">
                                <layout align="left" width="280" margins="{right=12}">
                                    <button align="bottom" height="26" text="Remover imagem"
                                            fontSize="9" onClick="removerRetrato()" margins="{top=4}"/>
                                    <rectangle align="client" color="#25252B" strokeColor="#8A3340"
                                               strokeSize="2"/>
                                    <image name="imgRetrato" align="client" field="retrato" editable="true"
                                           style="proportional" onPictureLoadedChange="atualizarDicaRetrato()"
                                           onLoad="atualizarDicaRetrato()"/>
                                    <label name="dicaRetrato" text="Clique aqui para adicionar imagem" align="client"
                                           fontSize="11" fontColor="#E4C2C6" horzTextAlign="center"
                                           vertTextAlign="center"/>
                                </layout>
                                <layout align="client">
                                    <layout align="top" height="34" margins="{bottom=6}">
                                        <label text="ESTRESSE FÍSICO" align="left" width="150" fontSize="11" fontColor="#E4C2C6" fontStyle="bold" vertTextAlign="center"/>
                                        <checkBox name="chkFisicoTopo_1" align="left" width="30" field="stF1" text="1" fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                        <checkBox name="chkFisicoTopo_2" align="left" width="30" field="stF2" text="2" fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                        <checkBox name="chkFisicoTopo_3" align="left" width="30" field="stF3" text="3" fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                        <checkBox name="chkFisicoTopo_4" align="left" width="30" field="stF4" text="4" fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                        <checkBox name="chkFisicoTopo_5" align="left" width="30" field="stF5" text="5" fontSize="10" visible="false"/>
                                        <checkBox name="chkFisicoTopo_6" align="left" width="30" field="stF6" text="6" fontSize="10" visible="false"/>
                                        <checkBox name="chkFisicoTopo_7" align="left" width="30" field="stF7" text="7" fontSize="10" visible="false"/>
                                        <checkBox name="chkFisicoTopo_8" align="left" width="30" field="stF8" text="8" fontSize="10" visible="false"/>
                                    </layout>
                                    <layout align="top" height="34" margins="{bottom=8}">
                                        <label text="ESTRESSE MENTAL" align="left" width="150" fontSize="11" fontColor="#E4C2C6" fontStyle="bold" vertTextAlign="center"/>
                                        <checkBox name="chkMentalTopo_1" align="left" width="30" field="stM1" text="1" fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                        <checkBox name="chkMentalTopo_2" align="left" width="30" field="stM2" text="2" fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                        <checkBox name="chkMentalTopo_3" align="left" width="30" field="stM3" text="3" fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                        <checkBox name="chkMentalTopo_4" align="left" width="30" field="stM4" text="4" fontSize="10" fontColor="#C97A85" fontStyle="bold"/>
                                        <checkBox name="chkMentalTopo_5" align="left" width="30" field="stM5" text="5" fontSize="10" visible="false"/>
                                        <checkBox name="chkMentalTopo_6" align="left" width="30" field="stM6" text="6" fontSize="10" visible="false"/>
                                        <checkBox name="chkMentalTopo_7" align="left" width="30" field="stM7" text="7" fontSize="10" visible="false"/>
                                        <checkBox name="chkMentalTopo_8" align="left" width="30" field="stM8" text="8" fontSize="10" visible="false"/>
                                    </layout>
                                    <layout align="top" height="34" margins="{bottom=6}"><label text="CONSEQUÊNCIA SUAVE [2]" align="left" width="180" fontSize="11" fontColor="#D1A04B" fontStyle="bold" vertTextAlign="center"/><edit align="client" field="cons_suave" fontSize="12"/></layout>
                                    <layout align="top" height="34" name="rowConsCSExtraTopo" margins="{bottom=6}"><label text="CONSEQUÊNCIA SUAVE+ [2]" align="left" width="180" fontSize="11" fontColor="#D1A04B" fontStyle="bold" vertTextAlign="center"/><edit align="client" field="cons_suaveX" fontSize="12"/></layout>
                                    <layout align="top" height="34" margins="{bottom=6}"><label text="CONSEQUÊNCIA MODERADA [4]" align="left" width="180" fontSize="11" fontColor="#D27649" fontStyle="bold" vertTextAlign="center"/><edit align="client" field="cons_moderada" fontSize="12"/></layout>
                                    <layout align="top" height="34"><label text="CONSEQUÊNCIA GRAVE [6]" align="left" width="180" fontSize="11" fontColor="#C95A63" fontStyle="bold" vertTextAlign="center"/><edit align="client" field="cons_severa" fontSize="12"/></layout>
                                </layout>
                                </layout>
                                </layout>
                            </layout>

                            <!-- Aspectos -->
                            <layout align="top" height="24" margins="{bottom=6}">
                                <rectangle align="left" width="4" color="#B9151F"/>
                                <label text="ASPECTOS" align="client" fontSize="14" fontColor="#E4C2C6"
                                       fontStyle="bold" margins="{left=8}" vertTextAlign="center"/>
                            </layout>

                            <label text="Conceito" align="top" height="16"
                                   fontSize="10" fontColor="#b9151f" fontStyle="bold"/>
                            <edit align="top" height="28" field="conceito"
                                  fontSize="13" margins="{bottom=8}"/>

                            <label text="Dificuldade" align="top" height="16"
                                   fontSize="10" fontColor="#b9151f" fontStyle="bold"/>
                            <edit align="top" height="28" field="dificuldade"
                                  fontSize="13" margins="{bottom=8}"/>

                            <layout align="top" height="44" name="rowAspecto_1" margins="{bottom=5}">
                                <label text="Aspecto" align="top" height="16" fontSize="10" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto1" fontSize="13"/>
                            </layout>
                            <layout align="top" height="44" name="rowAspecto_2" margins="{bottom=5}">
                                <label text="Aspecto" align="top" height="16" fontSize="10" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto2" fontSize="13"/>
                            </layout>
                            <layout align="top" height="44" name="rowAspecto_3" margins="{bottom=5}">
                                <label text="Aspecto" align="top" height="16" fontSize="10" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto3" fontSize="13"/>
                            </layout>
                            <layout align="top" height="44" name="rowAspecto_4" visible="false" margins="{bottom=5}">
                                <label text="Aspecto" align="top" height="16" fontSize="10" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto4" fontSize="13"/>
                            </layout>
                            <layout align="top" height="44" name="rowAspecto_5" visible="false" margins="{bottom=5}">
                                <label text="Aspecto" align="top" height="16" fontSize="10" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto5" fontSize="13"/>
                            </layout>
                            <layout align="top" height="44" name="rowAspecto_6" visible="false" margins="{bottom=5}">
                                <label text="Aspecto" align="top" height="16" fontSize="10" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto6" fontSize="13"/>
                            </layout>
                            <layout align="top" height="44" name="rowAspecto_7" visible="false" margins="{bottom=5}">
                                <label text="Aspecto" align="top" height="16" fontSize="10" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto7" fontSize="13"/>
                            </layout>

                            </layout>
                        </layout>
                    </layout>

                    <!-- ── Façanhas e Extras ── -->
                    <layout name="listaPericiasFacanhas" align="top" height="600" margins="{bottom=10}">
                        <layout align="left" width="520" margins="{right=12}">
                            <rectangle name="cardPericias" align="client" color="#242328" strokeColor="#4F2930" strokeSize="1"/>
                            <layout name="paddingPericias" align="client" margins="{left=8, right=8, top=8, bottom=8}">
                            <layout align="top" height="30" margins="{bottom=6}">
                                <rectangle align="left" width="4" color="#B9151F"/>
                                <label text="PERÍCIAS" align="left" width="130" fontSize="14" fontColor="#E4C2C6" fontStyle="bold" vertTextAlign="center" margins="{left=8}"/>
                                <button align="right" width="116" height="30" text="+ Adicionar Perícia" fontSize="11" onClick="adicionarPericia()"/>
                            </layout>
                            <layout align="top" height="16" margins="{bottom=4}">
                                <label text="Valor" align="left" width="52" fontSize="9" fontColor="#C97A85" fontStyle="bold" horzTextAlign="center" margins="{right=4}"/>
                                <label text="Nome" align="client" fontSize="9" fontColor="#C97A85" fontStyle="bold" margins="{right=4}"/>
                                <layout align="right" width="126" margins="{right=4}">
                                    <label text="Bônus" align="left" width="52" fontSize="9" fontColor="#C97A85" fontStyle="bold" horzTextAlign="center"/>
                                    <label text="Rolar" align="left" width="42" fontSize="9" fontColor="#C97A85" fontStyle="bold" horzTextAlign="center"/>
                                    <label text="" align="client"/>
                                </layout>
                            </layout>
                            <layout align="top" height="52" name="rowPericia_1" margins="{bottom=5}"><layout align="top" height="30"><edit align="left" width="52" field="pericia1_valor" hint="Valor" fontSize="12" horzTextAlign="center" onExit="atualizarNivelPericia(1)" margins="{right=4}"/><edit name="pericia_1_nome" align="client" field="pericia1_nome" hint="Nome" fontSize="13" margins="{right=4}"/><layout align="right" width="126" margins="{right=4}"><edit align="left" width="52" field="pericia1_bonus" hint="Bônus" fontSize="12" horzTextAlign="center"/><button align="left" width="42" text="dF" fontSize="11" onClick="rolarFate(self.pericia_1_nome.text, self.pericia_1_bonus.text)"/><button align="client" text="X" fontSize="14" fontColor="#C95A63" fontStyle="bold" hint="Remover" onClick="removerPericia(1)"/></layout></layout><label name="nivelPericia_1" text="" align="client" fontSize="10" fontColor="Gray"/></layout>
                            <layout align="top" height="52" name="rowPericia_2" margins="{bottom=5}"><layout align="top" height="30"><edit align="left" width="52" field="pericia2_valor" hint="Valor" fontSize="12" horzTextAlign="center" onExit="atualizarNivelPericia(2)" margins="{right=4}"/><edit name="pericia_2_nome" align="client" field="pericia2_nome" hint="Nome" fontSize="13" margins="{right=4}"/><layout align="right" width="126" margins="{right=4}"><edit align="left" width="52" field="pericia2_bonus" hint="Bônus" fontSize="12" horzTextAlign="center"/><button align="left" width="42" text="dF" fontSize="11" onClick="rolarFate(self.pericia_2_nome.text, self.pericia_2_bonus.text)"/><button align="client" text="X" fontSize="14" fontColor="#C95A63" fontStyle="bold" hint="Remover" onClick="removerPericia(2)"/></layout></layout><label name="nivelPericia_2" text="" align="client" fontSize="10" fontColor="Gray"/></layout>
                            <layout align="top" height="52" name="rowPericia_3" margins="{bottom=5}"><layout align="top" height="30"><edit align="left" width="52" field="pericia3_valor" hint="Valor" fontSize="12" horzTextAlign="center" onExit="atualizarNivelPericia(3)" margins="{right=4}"/><edit name="pericia_3_nome" align="client" field="pericia3_nome" hint="Nome" fontSize="13" margins="{right=4}"/><layout align="right" width="126" margins="{right=4}"><edit align="left" width="52" field="pericia3_bonus" hint="Bônus" fontSize="12" horzTextAlign="center"/><button align="left" width="42" text="dF" fontSize="11" onClick="rolarFate(self.pericia_3_nome.text, self.pericia_3_bonus.text)"/><button align="client" text="X" fontSize="14" fontColor="#C95A63" fontStyle="bold" hint="Remover" onClick="removerPericia(3)"/></layout></layout><label name="nivelPericia_3" text="" align="client" fontSize="10" fontColor="Gray"/></layout>
