                                            <edit align="right" width="24" field="per2_4v" hint="0" horzTextAlign="center" fontSize="10" margins="{right=2}"/>
                                            <button align="right" width="24" height="24" text="dF" fontSize="8" onClick="rolarFate(self.per2_4.text, self.per2_4v.text)"/>
                                        </layout>
                                    </layout>
