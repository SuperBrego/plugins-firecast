                                <layout align="top" height="28" name="rowFacanha_4" visible="false" margins="{bottom=4}"><label text="04" align="left" width="28" fontSize="10" fontColor="#C97A85" fontStyle="bold" vertTextAlign="center"/><edit align="client" field="facanha4" fontSize="13" margins="{right=6}"/><button align="right" width="32" text="X" fontSize="14" fontColor="#C95A63" fontStyle="bold" hint="Remover" onClick="removerFacanha(4)"/></layout>
