                                <checkBox name="chkFisico_6" align="left" width="28" field="stF6" text="6" fontSize="10" visible="false"/>
                                <checkBox name="chkFisico_7" align="left" width="28" field="stF7" text="7" fontSize="10" visible="false"/>
                                <checkBox name="chkFisico_8" align="left" width="28" field="stF8" text="8" fontSize="10" visible="false"/>
                            </layout>

                            <!-- Mental -->
