                                   field="retrato" editable="true"
                                   style="proportional"
                                   margins="{bottom=8}"/>

                            <!-- Aspectos -->
                            <label text="Aspectos" align="top" height="18"
                                   fontSize="9" fontColor="Gray" fontStyle="bold"
                                   margins="{bottom=4}"/>

                            <label text="Conceito" align="top" height="12"
                                   fontSize="7" fontColor="#b9151f" fontStyle="bold"/>
                            <edit align="top" height="22" field="conceito"
                                  fontSize="11" margins="{bottom=6}"/>

                            <label text="Dificuldade" align="top" height="12"
                                   fontSize="7" fontColor="#b9151f" fontStyle="bold"/>
                            <edit align="top" height="22" field="dificuldade"
                                  fontSize="11" margins="{bottom=6}"/>

                            <layout align="top" height="22" name="rowAspecto_1" margins="{bottom=4}">
                                <label text="Aspecto" align="top" height="12" fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto1" fontSize="10"/>
                            </layout>
                            <layout align="top" height="22" name="rowAspecto_2" margins="{bottom=4}">
                                <label text="Aspecto" align="top" height="12" fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto2" fontSize="10"/>
                            </layout>
                            <layout align="top" height="22" name="rowAspecto_3" margins="{bottom=4}">
                                <label text="Aspecto" align="top" height="12" fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto3" fontSize="10"/>
                            </layout>
                            <layout align="top" height="22" name="rowAspecto_4" visible="false" margins="{bottom=4}">
                                <label text="Aspecto" align="top" height="12" fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto4" fontSize="10"/>
                            </layout>
                            <layout align="top" height="22" name="rowAspecto_5" visible="false" margins="{bottom=4}">
                                <label text="Aspecto" align="top" height="12" fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto5" fontSize="10"/>
                            </layout>
                            <layout align="top" height="22" name="rowAspecto_6" visible="false" margins="{bottom=4}">
                                <label text="Aspecto" align="top" height="12" fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto6" fontSize="10"/>
                            </layout>
                            <layout align="top" height="22" name="rowAspecto_7" visible="false" margins="{bottom=4}">
                                <label text="Aspecto" align="top" height="12" fontSize="7" fontColor="Gray" fontStyle="bold"/>
                                <edit align="client" field="aspecto7" fontSize="10"/>
                            </layout>

                        </layout>
                    </layout>

                    <!-- ── Façanhas e Extras ── -->
                    <layout align="top" height="200" margins="{bottom=8}">

                        <!-- Façanhas -->
                        <layout align="left" width="260" margins="{right=8}">
                            <label text="Façanhas" align="top" height="18"
                                   fontSize="9" fontColor="Gray" fontStyle="bold"
                                   margins="{bottom=4}"/>
                            <layout align="client">
                                <layout align="top" height="22" name="rowFacanha_1" margins="{bottom=3}"><edit align="client" field="facanha1" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_2" margins="{bottom=3}"><edit align="client" field="facanha2" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_3" margins="{bottom=3}"><edit align="client" field="facanha3" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_4" margins="{bottom=3}"><edit align="client" field="facanha4" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_5" margins="{bottom=3}"><edit align="client" field="facanha5" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_6" margins="{bottom=3}"><edit align="client" field="facanha6" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_7" visible="false" margins="{bottom=3}"><edit align="client" field="facanha7" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_8" visible="false" margins="{bottom=3}"><edit align="client" field="facanha8" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_9" visible="false" margins="{bottom=3}"><edit align="client" field="facanha9" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowFacanha_10" visible="false"><edit align="client" field="facanha10" fontSize="10"/></layout>
                            </layout>
                        </layout>

                        <!-- Extras (lista resumida) -->
                        <layout align="client">
                            <label text="Extras" align="top" height="18"
                                   fontSize="9" fontColor="Gray" fontStyle="bold"
                                   margins="{bottom=4}"/>
                            <layout align="client">
                                <layout align="top" height="22" name="rowExtraL_1" margins="{bottom=3}"><edit align="client" field="extraL1" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_2" margins="{bottom=3}"><edit align="client" field="extraL2" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_3" margins="{bottom=3}"><edit align="client" field="extraL3" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_4" margins="{bottom=3}"><edit align="client" field="extraL4" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_5" margins="{bottom=3}"><edit align="client" field="extraL5" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_6" margins="{bottom=3}"><edit align="client" field="extraL6" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_7" visible="false" margins="{bottom=3}"><edit align="client" field="extraL7" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_8" visible="false" margins="{bottom=3}"><edit align="client" field="extraL8" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_9" visible="false" margins="{bottom=3}"><edit align="client" field="extraL9" fontSize="10"/></layout>
                                <layout align="top" height="22" name="rowExtraL_10" visible="false"><edit align="client" field="extraL10" fontSize="10"/></layout>
                            </layout>
                        </layout>

                    </layout>

                    <!-- ── Estresse e Consequências ── -->
                    <layout align="top" height="160">

                        <!-- Estresse -->
                        <layout align="left" width="260" margins="{right=8}">
                            <label text="Estresse" align="top" height="18"
                                   fontSize="9" fontColor="Gray" fontStyle="bold"
                                   margins="{bottom=6}"/>

                            <!-- Físico -->
                            <layout align="top" height="32" margins="{bottom=8}">
                                <label text="Físico" align="left" width="48"
                                       fontSize="8" fontColor="Gray" vertTextAlign="center"/>
                                <checkBox name="chkFisico_1" align="left" width="28" field="stF1" text="1" fontSize="8"/>
                                <checkBox name="chkFisico_2" align="left" width="28" field="stF2" text="2" fontSize="8"/>
                                <checkBox name="chkFisico_3" align="left" width="28" field="stF3" text="3" fontSize="8"/>
                                <checkBox name="chkFisico_4" align="left" width="28" field="stF4" text="4" fontSize="8"/>
                                <checkBox name="chkFisico_5" align="left" width="28" field="stF5" text="5" fontSize="8" visible="false"/>
                                <checkBox name="chkFisico_6" align="left" width="28" field="stF6" text="6" fontSize="8" visible="false"/>
                                <checkBox name="chkFisico_7" align="left" width="28" field="stF7" text="7" fontSize="8" visible="false"/>
                                <checkBox name="chkFisico_8" align="left" width="28" field="stF8" text="8" fontSize="8" visible="false"/>
                            </layout>

                            <!-- Mental -->
                            <layout align="top" height="32">
                                <label text="Mental" align="left" width="48"
                                       fontSize="8" fontColor="Gray" vertTextAlign="center"/>
                                <checkBox name="chkMental_1" align="left" width="28" field="stM1" text="1" fontSize="8"/>
                                <checkBox name="chkMental_2" align="left" width="28" field="stM2" text="2" fontSize="8"/>
                                <checkBox name="chkMental_3" align="left" width="28" field="stM3" text="3" fontSize="8"/>
                                <checkBox name="chkMental_4" align="left" width="28" field="stM4" text="4" fontSize="8"/>
                                <checkBox name="chkMental_5" align="left" width="28" field="stM5" text="5" fontSize="8" visible="false"/>
                                <checkBox name="chkMental_6" align="left" width="28" field="stM6" text="6" fontSize="8" visible="false"/>
                                <checkBox name="chkMental_7" align="left" width="28" field="stM7" text="7" fontSize="8" visible="false"/>
                                <checkBox name="chkMental_8" align="left" width="28" field="stM8" text="8" fontSize="8" visible="false"/>
                            </layout>
                        </layout>

                        <!-- Consequências -->
                        <layout align="client">
                            <label text="Consequências" align="top" height="18"
                                   fontSize="9" fontColor="Gray" fontStyle="bold"
                                   margins="{bottom=4}"/>

                            <layout align="top" height="26" margins="{bottom=4}">
                                <label text="[2] Suave" align="left" width="72"
                                       fontSize="8" fontColor="#b9151f" vertTextAlign="center"/>
                                <edit align="client" field="cons_suave" fontSize="10"/>
                            </layout>
                            <layout align="top" height="26" name="rowConsCSExtra" margins="{bottom=4}">
                                <label text="[2] Suave+" align="left" width="72"
                                       fontSize="8" fontColor="#b9151f" vertTextAlign="center"/>
                                <edit align="client" field="cons_suaveX" fontSize="10"/>
                            </layout>
                            <layout align="top" height="26" margins="{bottom=4}">
                                <label text="[4] Moderada" align="left" width="72"
                                       fontSize="8" fontColor="#b9151f" vertTextAlign="center"/>
                                <edit align="client" field="cons_moderada" fontSize="10"/>
                            </layout>
                            <layout align="top" height="26">
                                <label text="[6] Severa" align="left" width="72"
                                       fontSize="8" fontColor="#b9151f" vertTextAlign="center"/>
                                <edit align="client" field="cons_severa" fontSize="10"/>
                            </layout>
                        </layout>

                    </layout>

                </layout>
            </scrollBox>
        </tab>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ABA 2 — EXTRAS (detalhes)                                 -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <tab title="Extras">
            <scrollBox align="client">
                <layout align="client" margins="{left=10, right=10, top=10, bottom=10}">
                    <label text="Detalhes dos Extras" align="top" height="20"
                           fontSize="11" fontStyle="bold" margins="{bottom=8}"/>

                    <layout align="top" height="180" margins="{bottom=12}">
                        <label text="Extra 1" align="left" width="60" fontSize="9"
                               fontColor="Gray" fontStyle="bold" vertTextAlign="leading" margins="{top=4, right=8}"/>
                        <layout align="client">
                            <label text="Nome" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD1_nome" fontSize="11" margins="{bottom=4}"/>
                            <label text="Permissão" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD1_perm" fontSize="10" margins="{bottom=4}"/>
                            <label text="Custo" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD1_custo" fontSize="10" margins="{bottom=4}"/>
                            <label text="Descrição" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <textEditor align="client" field="extraD1_desc" fontSize="10"/>
                        </layout>
                    </layout>

                    <layout align="top" height="180" margins="{bottom=12}">
                        <label text="Extra 2" align="left" width="60" fontSize="9"
                               fontColor="Gray" fontStyle="bold" vertTextAlign="leading" margins="{top=4, right=8}"/>
                        <layout align="client">
                            <label text="Nome" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD2_nome" fontSize="11" margins="{bottom=4}"/>
                            <label text="Permissão" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD2_perm" fontSize="10" margins="{bottom=4}"/>
                            <label text="Custo" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD2_custo" fontSize="10" margins="{bottom=4}"/>
                            <label text="Descrição" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <textEditor align="client" field="extraD2_desc" fontSize="10"/>
                        </layout>
                    </layout>

                    <layout align="top" height="180" margins="{bottom=12}">
                        <label text="Extra 3" align="left" width="60" fontSize="9"
                               fontColor="Gray" fontStyle="bold" vertTextAlign="leading" margins="{top=4, right=8}"/>
                        <layout align="client">
                            <label text="Nome" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD3_nome" fontSize="11" margins="{bottom=4}"/>
                            <label text="Permissão" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD3_perm" fontSize="10" margins="{bottom=4}"/>
                            <label text="Custo" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD3_custo" fontSize="10" margins="{bottom=4}"/>
                            <label text="Descrição" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <textEditor align="client" field="extraD3_desc" fontSize="10"/>
                        </layout>
                    </layout>

                    <layout align="top" height="180" margins="{bottom=12}">
                        <label text="Extra 4" align="left" width="60" fontSize="9"
                               fontColor="Gray" fontStyle="bold" vertTextAlign="leading" margins="{top=4, right=8}"/>
                        <layout align="client">
                            <label text="Nome" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD4_nome" fontSize="11" margins="{bottom=4}"/>
                            <label text="Permissão" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD4_perm" fontSize="10" margins="{bottom=4}"/>
                            <label text="Custo" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD4_custo" fontSize="10" margins="{bottom=4}"/>
                            <label text="Descrição" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <textEditor align="client" field="extraD4_desc" fontSize="10"/>
                        </layout>
                    </layout>

                    <layout align="top" height="180" margins="{bottom=12}">
                        <label text="Extra 5" align="left" width="60" fontSize="9"
                               fontColor="Gray" fontStyle="bold" vertTextAlign="leading" margins="{top=4, right=8}"/>
                        <layout align="client">
                            <label text="Nome" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD5_nome" fontSize="11" margins="{bottom=4}"/>
                            <label text="Permissão" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD5_perm" fontSize="10" margins="{bottom=4}"/>
                            <label text="Custo" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD5_custo" fontSize="10" margins="{bottom=4}"/>
                            <label text="Descrição" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <textEditor align="client" field="extraD5_desc" fontSize="10"/>
                        </layout>
                    </layout>

                    <layout align="top" height="180">
                        <label text="Extra 6" align="left" width="60" fontSize="9"
                               fontColor="Gray" fontStyle="bold" vertTextAlign="leading" margins="{top=4, right=8}"/>
                        <layout align="client">
                            <label text="Nome" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD6_nome" fontSize="11" margins="{bottom=4}"/>
                            <label text="Permissão" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD6_perm" fontSize="10" margins="{bottom=4}"/>
                            <label text="Custo" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <edit align="top" height="22" field="extraD6_custo" fontSize="10" margins="{bottom=4}"/>
                            <label text="Descrição" align="top" height="14" fontSize="8" fontColor="Gray"/>
                            <textEditor align="client" field="extraD6_desc" fontSize="10"/>
                        </layout>
                    </layout>

                </layout>
            </scrollBox>
        </tab>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ABA 3 — CONFIGURAÇÃO                                      -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <tab title="Configuração">
            <scrollBox align="client">
                <layout align="client" margins="{left=12, right=12, top=12, bottom=12}">

                    <label text="Escada de Perícias" align="top" height="20"
                           fontStyle="bold" fontSize="13"/>
                    <label text="Define quais níveis da escada aparecem na ficha."
                           align="top" height="16" fontSize="11" fontColor="Gray" margins="{bottom=8}"/>

                    <layout align="top" height="28" margins="{bottom=8}">
                        <label text="Nível mínimo (+1 a +4)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="client" field="cfg_escadaMin"
                              hint="1" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>
                    <layout align="top" height="28" margins="{bottom=16}">
                        <label text="Nível máximo (+2 a +8)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="client" field="cfg_escadaMax"
                              hint="5" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>

                    <label text="Aspectos" align="top" height="20"
                           fontStyle="bold" fontSize="13"/>
                    <layout align="top" height="28" margins="{bottom=16, top=4}">
                        <label text="Aspectos livres (1 a 7)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="client" field="cfg_aspectos"
                              hint="3" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>

                    <label text="Façanhas e Extras" align="top" height="20"
                           fontStyle="bold" fontSize="13"/>
                    <layout align="top" height="28" margins="{bottom=4, top=4}">
                        <label text="Linhas de façanhas (1 a 10)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="client" field="cfg_facanhas"
                              hint="6" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>
                    <layout align="top" height="28" margins="{bottom=16}">
                        <label text="Linhas de extras (1 a 10)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="client" field="cfg_extrasL"
                              hint="6" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>

                    <label text="Estresse" align="top" height="20"
                           fontStyle="bold" fontSize="13"/>
                    <layout align="top" height="28" margins="{bottom=4, top=4}">
                        <label text="Caixas Físico (2 a 8)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="client" field="cfg_fisico"
                              hint="4" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>
                    <layout align="top" height="28" margins="{bottom=16}">
                        <label text="Caixas Mental (2 a 8)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="client" field="cfg_mental"
                              hint="4" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>

                    <label text="Consequências" align="top" height="20"
                           fontStyle="bold" fontSize="13"/>
                    <layout align="top" height="28" margins="{top=4}">
                        <label text="Consequência Suave extra" align="left" width="200"
                               fontSize="11" vertTextAlign="center"/>
                        <checkBox align="client" field="cfg_cse"
                                  text="" checked="true"
                                  onChange="aplicarConfig()"/>
                    </layout>

                </layout>
            </scrollBox>
        </tab>

    </tabControl>

</form>
