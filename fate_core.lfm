                                <label text="Mental" align="left" width="48"
                                       fontSize="10" fontColor="Gray" vertTextAlign="center"/>
                                <checkBox name="chkMental_1" align="left" width="28" field="stM1" text="1" fontSize="10"/>
                                <checkBox name="chkMental_2" align="left" width="28" field="stM2" text="2" fontSize="10"/>
                                <checkBox name="chkMental_3" align="left" width="28" field="stM3" text="3" fontSize="10"/>
                                <checkBox name="chkMental_4" align="left" width="28" field="stM4" text="4" fontSize="10"/>
                                <checkBox name="chkMental_5" align="left" width="28" field="stM5" text="5" fontSize="10" visible="false"/>
                                <checkBox name="chkMental_6" align="left" width="28" field="stM6" text="6" fontSize="10" visible="false"/>
                                <checkBox name="chkMental_7" align="left" width="28" field="stM7" text="7" fontSize="10" visible="false"/>
                                <checkBox name="chkMental_8" align="left" width="28" field="stM8" text="8" fontSize="10" visible="false"/>
                            </layout>
                        </layout>

                        <!-- Consequências -->
                        <layout align="client">
                            <label text="Consequências" align="top" height="18"
                                   fontSize="11" fontColor="Gray" fontStyle="bold"
                                   margins="{bottom=4}"/>

                            <layout align="top" height="26" margins="{bottom=4}">
                                <label text="[2] Suave" align="left" width="72"
                                       fontSize="10" fontColor="#b9151f" vertTextAlign="center"/>
                                <edit align="client" field="cons_suave" fontSize="10"/>
                            </layout>
                            <layout align="top" height="26" name="rowConsCSExtra" margins="{bottom=4}">
                                <label text="[2] Suave+" align="left" width="72"
