        <tab title="Pessoal">
            <layout align="client">
                <image name="texturaPessoal" align="client" src="assets/fate-textura-grafite.png" style="stretch" opacity="0.12"/>
                <scrollBox align="client">
                <layout name="conteudoPessoal" align="top" height="1110" margins="{left=10, right=10, top=10, bottom=10}">

                    <layout align="top" height="210" margins="{bottom=12}">
                    <layout align="client">
                    <rectangle name="cardPessoalIdent" align="client" color="#242328" strokeColor="#4F2930" strokeSize="1"/>
                    <layout align="client" margins="{left=8, right=8, top=8, bottom=8}">
                    <layout align="top" height="22" margins="{bottom=6}">
                        <rectangle align="left" width="4" color="#B9151F"/>
                        <label text="IDENTIFICAÇÃO" align="client" fontSize="14" fontColor="#E4C2C6" fontStyle="bold" margins="{left=8}" vertTextAlign="center"/>
                    </layout>
                    <layout align="top" height="54" margins="{bottom=6}">
                        <layout align="left" width="380" margins="{right=4}"><label text="Nome" align="top" height="18" fontSize="11" fontColor="Gray"/><edit align="client" field="nome" fontSize="13"/></layout>
                        <layout align="client" margins="{left=4}"><label text="Nome alternativo / Alcunha" align="top" height="18" fontSize="11" fontColor="Gray"/><edit align="client" field="nomeAlternativo" fontSize="13"/></layout>
                    </layout>
                    <layout align="top" height="54" margins="{bottom=6}">
                        <layout align="left" width="250" margins="{right=4}"><label text="Idade" align="top" height="18" fontSize="11" fontColor="Gray"/><edit align="client" field="idade" fontSize="13"/></layout>
                        <layout align="left" width="260" margins="{left=4, right=4}"><label text="Gênero" align="top" height="18" fontSize="11" fontColor="Gray"/><edit align="client" field="genero" fontSize="13"/></layout>
                        <layout align="client" margins="{left=4}"><label text="Espécie / Raça" align="top" height="18" fontSize="11" fontColor="Gray"/><edit align="client" field="especieRaca" fontSize="13"/></layout>
                    </layout>
                    <layout align="top" height="54" margins="{bottom=18}">
                        <layout align="left" width="250" margins="{right=4}"><label text="Ocupação" align="top" height="18" fontSize="11" fontColor="Gray"/><edit align="client" field="ocupacao" fontSize="13"/></layout>
                        <layout align="left" width="260" margins="{left=4, right=4}"><label text="Origem" align="top" height="18" fontSize="11" fontColor="Gray"/><edit align="client" field="origem" fontSize="13"/></layout>
                        <layout align="client" margins="{left=4}"><label text="Afiliação" align="top" height="18" fontSize="11" fontColor="Gray"/><edit align="client" field="afiliacao" fontSize="13"/></layout>
                    </layout>
                    </layout>
                    </layout>
                    </layout>

                    <layout name="secaoDescricaoPessoal" align="top" height="420">
                    <layout align="client">
                    <rectangle name="cardPessoalDescricao" align="client" color="#242328" strokeColor="#4F2930" strokeSize="1"/>
                    <layout align="client" margins="{left=8, right=8, top=8, bottom=8}">
                    <layout align="top" height="22" margins="{bottom=6}">
                        <rectangle align="left" width="4" color="#B9151F"/>
                        <label text="DESCRIÇÃO DO PERSONAGEM" align="client" fontSize="14" fontColor="#E4C2C6" fontStyle="bold" margins="{left=8}" vertTextAlign="center"/>
                    </layout>
                    <layout align="top" height="112" margins="{bottom=8}">
                        <layout align="left" width="450" margins="{right=4}"><label text="Aparência" align="top" height="18" fontSize="11" fontColor="Gray"/><textEditor align="client" field="aparencia" fontSize="12"/></layout>
                        <layout align="client" margins="{left=4}"><label text="Personalidade" align="top" height="18" fontSize="11" fontColor="Gray"/><textEditor align="client" field="personalidade" fontSize="12"/></layout>
                    </layout>
                    <layout align="top" height="150" margins="{bottom=8}"><label text="História" align="top" height="18" fontSize="11" fontColor="Gray"/><textEditor align="client" field="historia" fontSize="12"/></layout>
                    <layout align="top" height="112" margins="{bottom=18}">
                        <layout align="left" width="450" margins="{right=4}"><label text="Objetivos, Ideais, Medos e Fraquezas" align="top" height="32" fontSize="10" fontColor="Gray"/><textEditor align="client" field="motivacoes" fontSize="12"/></layout>
                        <layout align="client" margins="{left=4}"><label text="Relacionamentos" align="top" height="18" fontSize="11" fontColor="Gray"/><textEditor align="client" field="relacionamentos" fontSize="12"/></layout>
                    </layout>

                    </layout>
                    </layout>
                    </layout>
                    <layout name="secaoRecursosPessoal" align="top" height="390">

                    <layout align="client">
                    <rectangle name="cardPessoalRecursos" align="client" color="#242328" strokeColor="#4F2930" strokeSize="1"/>
                    <layout align="client" margins="{left=8, right=8, top=8, bottom=8}">
                    <layout align="top" height="22" margins="{bottom=6}">
                        <rectangle align="left" width="4" color="#B9151F"/>
                        <label text="RECURSOS" align="client" fontSize="14" fontColor="#E4C2C6" fontStyle="bold" margins="{left=8}" vertTextAlign="center"/>
                    </layout>
                    <layout align="top" height="112" margins="{bottom=8}"><label text="Equipamentos e Pertences" align="top" height="18" fontSize="11" fontColor="Gray"/><textEditor align="client" field="equipamentosPertences" fontSize="12"/></layout>
                    <layout align="top" height="112" margins="{bottom=8}"><label text="Aliados e Contatos" align="top" height="18" fontSize="11" fontColor="Gray"/><textEditor align="client" field="aliadosContatos" fontSize="12"/></layout>
                    <layout align="top" height="112"><label text="Outras Informações" align="top" height="18" fontSize="11" fontColor="Gray"/><textEditor align="client" field="outrasInformacoes" fontSize="12"/></layout>
                    </layout>
                    </layout>
                    </layout>

                </layout>
                </scrollBox>
            </layout>
        </tab>

        <tab title="Configuração">
            <layout align="client">
                <image name="texturaConfiguracao" align="client" src="assets/fate-textura-grafite.png" style="stretch" opacity="0.12"/>
                <scrollBox align="client">
                <layout align="client" margins="{left=12, right=12, top=12, bottom=12}">

                    <layout align="top" height="22" margins="{bottom=4}">
                        <rectangle align="left" width="4" color="#B9151F"/>
                        <label text="ESTRESSE" align="client" fontStyle="bold" fontSize="14"
                               fontColor="#E4C2C6" margins="{left=8}" vertTextAlign="center"/>
                    </layout>
                    <layout align="top" height="28" margins="{bottom=4, top=4}">
                        <label text="Caixas Físico (2 a 8)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="left" width="54" field="cfg_fisico"
                              hint="4" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>
                    <layout align="top" height="28" margins="{bottom=16}">
                        <label text="Caixas Mental (2 a 8)" align="left" width="180"
                               fontSize="11" vertTextAlign="center"/>
                        <edit align="left" width="54" field="cfg_mental"
                              hint="4" horzTextAlign="center"
                              onExit="aplicarConfig()"/>
                    </layout>

                    <layout align="top" height="22" margins="{bottom=4}">
                        <rectangle align="left" width="4" color="#B9151F"/>
                        <label text="CONSEQUÊNCIAS" align="client" fontStyle="bold" fontSize="14"
                               fontColor="#E4C2C6" margins="{left=8}" vertTextAlign="center"/>
                    </layout>
                    <layout align="top" height="28" margins="{top=4}">
                        <label text="Consequência Suave extra" align="left" width="200"
                               fontSize="11" vertTextAlign="center"/>
                        <checkBox align="client" field="cfg_cse"
                                  text="" checked="true"
                                  onChange="aplicarConfig()"/>
                    </layout>

                    <layout align="top" height="32" margins="{top=14}">
                        <label text="Modo compacto" align="left" width="200" fontSize="11" vertTextAlign="center"/>
                        <checkBox align="left" width="28" field="cfg_compacto" text="" onChange="aplicarConfig()"/>
                        <label text="Oculta as descrições longas na aba Pessoal." align="client" fontSize="10" fontColor="Gray" vertTextAlign="center"/>
                    </layout>

                    <layout align="top" height="42" margins="{top=12}">
                        <label text="Tema visual" align="left" width="200" fontSize="11" vertTextAlign="center"/>
                        <comboBox align="left" width="220" field="cfg_tema"
                                  items="{'Grafite e vinho', 'Pergaminho clássico', 'Alto contraste'}"
                                  values="{'grafite', 'classico', 'contraste'}"
                                  onChange="aplicarConfig()"/>
                        <label text="Aplicado a cartões e textura de fundo." align="client" fontSize="10" fontColor="Gray" vertTextAlign="center" margins="{left=8}"/>
                    </layout>

                </layout>
                </scrollBox>
            </layout>
        </tab>

    </tabControl>

</form>
